---
import { copy, identity, withLocale, type Locale } from '@/data/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routePath: string;
  image?: string;
  imageAlt?: string;
  pageSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
  themeColor?: string;
  colorScheme?: 'dark' | 'light' | 'light dark';
  bodyClass?: string;
  /** Not-found page: kept out of search and without language alternates. */
  errorPage?: boolean;
}

const {
  locale,
  title,
  description,
  routePath,
  image = '/images/social-card.png',
  imageAlt,
  pageSchema,
  themeColor = '#09090d',
  colorScheme = 'dark',
  bodyClass,
  errorPage = false,
} = Astro.props;
const t = copy[locale];
const path = routePath.replace(/^\/+|\/+$/g, '');
const canonicalPath = withLocale(locale, path);
const canonical = new URL(canonicalPath, Astro.site);
const fullTitle = path ? `${title} | ${identity.name}` : `${identity.name} | ${title}`;
const imageUrl = new URL(image, Astro.site);
const socialImageAlt = imageAlt ?? (locale === 'pt' ? `Prévia do portfólio de ${identity.name}` : `${identity.name} portfolio preview`);
const structuredDescription = ['', 'services', 'about', 'cv', 'contact'].includes(path) ? identity.summary[locale] : description;
const markdownPath = `/markdown/${locale}/${path || 'index'}.md`;
const parentSection = path.startsWith('services/') ? 'services' : 'work';
const breadcrumbSchema = path && !errorPage ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: locale === 'pt' ? 'Início' : 'Home',
      item: new URL(withLocale(locale), Astro.site).toString(),
    },
    ...(path.includes('/') ? [{
      '@type': 'ListItem',
      position: 2,
      name: parentSection === 'work' ? t.nav.work : t.nav.services,
      item: new URL(withLocale(locale, parentSection), Astro.site).toString(),
    }] : []),
    {
      '@type': 'ListItem',
      position: path.includes('/') ? 3 : 2,
      name: title,
      item: canonical.toString(),
    },
  ],
} : undefined;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: fullTitle,
    description: structuredDescription,
    url: canonical.toString(),
    inLanguage: locale === 'pt' ? 'pt-BR' : 'en',
    isPartOf: {
      '@type': 'WebSite',
      name: `${identity.name} Portfolio`,
      url: new URL('/', Astro.site).toString(),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: identity.name,
    jobTitle: identity.role[locale],
    description: identity.summary[locale],
    url: new URL(withLocale(locale), Astro.site).toString(),
    email: `mailto:${identity.email}`,
    telephone: identity.phoneDisplay,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Viseu',
      addressCountry: 'PT',
    },
    sameAs: [identity.github, identity.linkedin, identity.edgeData],
    knowsAbout: ['B2B SaaS', 'Internal systems', 'Platform modernization', 'React', 'TypeScript', 'Laravel', 'Node.js', '.NET', 'React Native', 'System integrations', 'AI automation', 'Retrieval-augmented generation'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${identity.name} Portfolio`,
    url: new URL('/', Astro.site).toString(),
    inLanguage: ['en', 'pt-BR'],
  },
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(Array.isArray(pageSchema) ? pageSchema : pageSchema ? [pageSchema] : []),
];
---

<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={colorScheme} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <meta name="robots" content={errorPage ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!errorPage && <link rel="canonical" href={canonical} />}
    {!errorPage && (
      <>
        <link rel="alternate" hreflang="pt-BR" href={new URL(withLocale('pt', path), Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(withLocale('en', path), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(withLocale('pt', path), Astro.site)} />
        <link rel="alternate" type="text/markdown" href={markdownPath} title={locale === 'pt' ? `${title} em Markdown` : `${title} in Markdown`} />
      </>
    )}
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/geologica-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <slot />
  </body>
</html>
