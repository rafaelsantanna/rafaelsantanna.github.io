---
import Document from '@/layouts/Document.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WebMcpTools from '@/components/WebMcpTools.astro';
import '@/styles/global.css';
import { type Locale } from '@/data/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routePath: string;
  image?: string;
  imageAlt?: string;
  pageSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
  errorPage?: boolean;
}

const { locale, title, description, routePath, image, imageAlt, pageSchema, errorPage } = Astro.props;
const path = routePath.replace(/^\/+|\/+$/g, '');
---

<Document locale={locale} title={title} description={description} routePath={routePath} image={image} imageAlt={imageAlt} pageSchema={pageSchema} bodyClass="site" errorPage={errorPage}>
  <Header locale={locale} routePath={path} />
  <main id="main-content">
    <slot />
  </main>
  <Footer locale={locale} />
  <WebMcpTools />
</Document>
