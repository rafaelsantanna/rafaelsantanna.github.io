---
import Icon from '@/components/ui/Icon.astro';
import { clients, experience, timeline, withLocale, type Locale } from '@/data/content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const pt = locale === 'pt';

/** Takes the number an outcome in content.ts states ("more than 15 ..."), so the band cannot drift from the CV. */
const figureFrom = (slug: string, outcome: number) => {
  const entry = experience.find((item) => item.slug === slug);
  const amount = entry?.outcomes[locale][outcome]?.match(/\d[\d.,]*\d|\d/)?.[0];
  if (!entry || !amount) throw new Error(`No figure in the outcome ${outcome} of ${slug}.`);
  return { value: `${amount}+`, source: entry.company };
};
const figures = pt
  ? [
      { ...figureFrom('corporate-learning', 0), label: 'projetos LMS corporativos e educacionais entregues' },
      { ...figureFrom('academic-operations', 1), label: 'melhorias e funcionalidades entre frontend e backend, num projeto estimado para mais de um ano e entregue em cerca de seis meses' },
      { ...figureFrom('enterprise-operations', 0), label: 'usuários atendidos por uma plataforma integrada do Grupo Profarma' },
    ]
  : [
      { ...figureFrom('corporate-learning', 0), label: 'corporate and educational LMS projects delivered' },
      { ...figureFrom('academic-operations', 1), label: 'improvements and features across frontend and backend, on a project estimated at over a year and delivered in about six months' },
      { ...figureFrom('enterprise-operations', 0), label: 'users served by an integrated Grupo Profarma platform' },
    ];
const ui = pt
  ? { index: 'Experiência', title: 'Mais de 10 anos em produção.', lede: 'Construo e modernizo produtos B2B, sistemas internos e plataformas operacionais em educação, varejo, saúde, logística e infraestrutura.', timeline: 'Trajetória', figures: 'Em números', clients: 'Projetos para organizações como', about: 'Conhecer minha trajetória', cv: 'Ver currículo' }
  : { index: 'Experience', title: '10+ years in production.', lede: 'I build and modernize B2B products, internal systems, and operational platforms across education, retail, healthcare, logistics, and infrastructure.', timeline: 'Career', figures: 'In numbers', clients: 'Projects for organizations such as', about: 'Read my story', cv: 'View CV' };
---

<section class="experience section" aria-labelledby="experience-title">
  <div class="shell">
    <header class="section-head" data-reveal>
      <div class="section-head__title">
        <p class="section-index">{ui.index}</p>
        <h2 id="experience-title">{ui.title}</h2>
      </div>
      <div class="section-head__aside">
        <p class="lede">{ui.lede}</p>
      </div>
    </header>

    <div class="experience__grid">
      <div class="experience__timeline">
        <h3 class="experience__label">{ui.timeline}</h3>
        <ol class="rail">
          {timeline.map((item, index) => (
            <li class:list={['rail__item', { 'is-current': index === 0 }]}>
              <span class="rail__period">{item.period.replace('-', '–')}</span>
              <span class="rail__company">{item.company}</span>
              <span class="rail__role">{item.role[locale]}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="experience__figures">
        <h3 class="experience__label">{ui.figures}</h3>
        <ul class="figures">
          {figures.map((figure) => (
            <li class="figure" data-reveal>
              <span class="figure__value">{figure.value}</span>
              <span class="figure__label">{figure.label}</span>
              <span class="figure__source">{figure.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="experience__footer">
      <p class="experience__clients"><span>{ui.clients}</span> {clients.join(', ')}.</p>
      <div class="button-row">
        <a class="text-link" href={withLocale(locale, 'about')}>{ui.about}<Icon name="arrow-right" /></a>
        <a class="text-link" href={withLocale(locale, 'cv')}>{ui.cv}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>
