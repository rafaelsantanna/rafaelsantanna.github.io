---
import Icon from '@/components/ui/Icon.astro';
import Exhibit from '@/components/home/Exhibit.astro';
import LandingCard from '@/components/ui/LandingCard.astro';
import { projects, withLocale, type Locale } from '@/data/content';

interface Props { locale: Locale; id: string; systemsId: string }

const { locale, id, systemsId } = Astro.props;
const pt = locale === 'pt';
const products = projects.slice(0, 5);
const landingPages = projects.slice(5);
const ui = pt
  ? {
      landingIndex: `Sites · ${landingPages.length} modelos`,
      landingTitle: 'Sites para negócios locais',
      landingLede: 'Uma página para cada tipo de negócio, com identidade própria e um botão que leva o cliente direto ao seu WhatsApp.',
      offer: 'Preço, prazo e o que está incluído',
      systemsIndex: `Sistemas · ${products.length} demos`,
      systemsTitle: 'Sistemas, apps e IA',
      systemsLede: 'Para empresas que precisam organizar a operação: painéis, sistemas internos, telas antigas modernizadas, assistentes com IA e apps de campo.',
      disclosure: 'Todos os projetos são autorais, com marcas e dados de exemplo, e funcionam no navegador. A experiência com clientes está no currículo.',
    }
  : {
      landingIndex: `Websites · ${landingPages.length} models`,
      landingTitle: 'Websites for local businesses',
      landingLede: 'One page for each kind of business, with its own identity and a button that takes customers straight to your WhatsApp.',
      offer: 'Price, timeline, and what is included',
      systemsIndex: `Systems · ${products.length} demos`,
      systemsTitle: 'Systems, apps, and AI',
      systemsLede: 'For companies that need to organize operations: dashboards, internal systems, modernized legacy screens, AI assistants, and field apps.',
      disclosure: 'Every project is my own work, with sample brands and data, and runs in your browser. Client experience is in the CV.',
    };
---

<div class="showroom section" id={id}>
  <div class="shell">
    <section class="showroom__group" aria-labelledby="landing-title">
      <header class="section-head" data-reveal>
        <div class="section-head__title">
          <p class="section-index">{ui.landingIndex}</p>
          <h2 id="landing-title">{ui.landingTitle}</h2>
        </div>
        <div class="section-head__aside">
          <p class="lede">{ui.landingLede}</p>
          <a class="text-link" href={withLocale(locale, 'sites')}>{ui.offer}<Icon name="arrow-right" /></a>
        </div>
      </header>
      <p class="showroom__disclosure"><Icon name="info" /><span>{ui.disclosure}</span></p>
      <ul class="landing-pair__grid">
        {landingPages.map((project) => (
          <li data-reveal><LandingCard project={project} locale={locale} /></li>
        ))}
      </ul>
    </section>

    <section class="showroom__group" id={systemsId} aria-labelledby="systems-title">
      <header class="section-head" data-reveal>
        <div class="section-head__title">
          <p class="section-index">{ui.systemsIndex}</p>
          <h2 id="systems-title">{ui.systemsTitle}</h2>
        </div>
        <div class="section-head__aside">
          <p class="lede">{ui.systemsLede}</p>
        </div>
      </header>
      <ol class="exhibits">
        {products.map((project, index) => (
          <li><Exhibit project={project} locale={locale} index={index} /></li>
        ))}
      </ol>
    </section>
  </div>
</div>
