---
import Icon from '@/components/ui/Icon.astro';
import { paletteStyle } from '@/components/ui/palette';
import { findProject, localize, previewImage, withLocale, type Locale } from '@/data/content';
import { brl, type Niche } from '@/data/small-business';

interface Props { niche: Niche; locale: Locale; headingLevel?: 'h2' | 'h3' }

const { niche, locale, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const project = findProject(niche.demo);
if (!project) throw new Error(`Unknown demo for niche ${niche.slug}: ${niche.demo}`);
const pt = locale === 'pt';
const image = previewImage(project, locale).replace(/\.png$/, '');
const pageHref = withLocale(locale, `sites/${niche.slug}`);
---

<article class="niche-card" style={paletteStyle(project.palette)} aria-labelledby={`niche-${niche.slug}`}>
  <a class="niche-card__media" href={pageHref} tabindex="-1">
    <img src={`${image}-800.webp`} srcset={`${image}-800.webp 800w, ${image}-1200.webp 1200w`} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 100vw" width="800" height="500" alt={localize(project.preview.alt, locale)} loading="lazy" decoding="async" />
  </a>
  <div class="niche-card__body">
    <p class="niche-card__meta"><span class="eyebrow">{project.name}</span><span class="niche-card__price">{pt ? 'a partir de' : 'from'} {brl(niche.price)}</span></p>
    <Heading id={`niche-${niche.slug}`}><a href={pageHref}>{localize(niche.title, locale)}</a></Heading>
    <div class="button-row">
      <a class="button button--secondary button--small" href={withLocale(locale, `demos/${project.slug}`)} data-icon="up-right">
        {pt ? 'Abrir o modelo' : 'Open the model'}<span class="visually-hidden">: {project.name}</span><Icon name="arrow-up-right" />
      </a>
      <a class="text-link" href={pageHref}>{pt ? 'Como fica o seu' : 'How yours works'}<span class="visually-hidden">: {localize(niche.label, locale)}</span><Icon name="arrow-right" /></a>
    </div>
  </div>
</article>
