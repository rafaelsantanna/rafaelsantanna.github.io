---
import { localize, previewImage, withLocale, type DemoProject, type Locale } from '@/data/content';

interface Props {
  project: DemoProject;
  locale: Locale;
  loading?: 'lazy' | 'eager';
  /** Use when the frame repeats information already given in text nearby. */
  decorative?: boolean;
  /** Rendered width hint for the responsive image candidates. */
  sizes?: string;
  class?: string;
}

const { project, locale, loading = 'lazy', decorative = false, sizes = '(min-width: 64em) 55vw, 100vw', class: className } = Astro.props;
const { preview } = project;
const image = previewImage(project, locale);
const base = image.replace(/\.png$/, '');
const srcset = `${base}-800.webp 800w, ${base}-1200.webp 1200w, ${base}.webp ${preview.width}w`;
---

<div class:list={['frame', className]}>
  <div class="frame__bar" aria-hidden="true">
    <span class="frame__dots"><i></i><i></i><i></i></span>
    <span class="frame__url">{withLocale(locale, `demos/${project.slug}`)}</span>
  </div>
  <picture class="frame__media">
    <source type="image/webp" srcset={srcset} sizes={sizes} />
    <img
      src={image}
      width={preview.width}
      height={preview.height}
      alt={decorative ? '' : localize(preview.alt, locale)}
      loading={loading}
      decoding="async"
    />
  </picture>
</div>
