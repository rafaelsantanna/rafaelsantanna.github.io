---
/** Small hand-drawn stroke icons. Decorative by default (aria-hidden). */
export type IconName =
  | 'arrow-right'
  | 'arrow-left'
  | 'arrow-up-right'
  | 'arrow-down'
  | 'copy'
  | 'check'
  | 'download'
  | 'mail'
  | 'message'
  | 'pause'
  | 'play'
  | 'info'
  | 'reset'
  | 'shield'
  | 'cursor'
  | 'swipe'
  | 'pin'
  | 'globe'
  | 'clock';

interface Props { name: IconName; class?: string }

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'copy' && <><rect x="8.5" y="8.5" width="11.5" height="11.5" rx="2.25" /><path d="M15.5 8.5V6.25A2.25 2.25 0 0 0 13.25 4h-7A2.25 2.25 0 0 0 4 6.25v7a2.25 2.25 0 0 0 2.25 2.25H8.5" /></>}
  {name === 'check' && <path d="M5 12.5 9.5 17 19 7.5" />}
  {name === 'download' && <path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7.5 8 5.5 8-5.5" /></>}
  {name === 'message' && <path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.55L3.5 20.5l1.45-4.4A8.5 8.5 0 1 1 20.5 11.5Z" />}
  {name === 'pause' && <path d="M9 6.5v11M15 6.5v11" />}
  {name === 'play' && <path d="M8 5.75v12.5L18 12 8 5.75Z" />}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v5.5M12 7.75h.01" /></>}
  {name === 'reset' && <><path d="M4 12a8 8 0 1 0 2.35-5.65L4 8.7" /><path d="M4 4v4.7h4.7" /></>}
  {name === 'shield' && <><path d="M12 3 19 6v5.25c0 4.4-2.95 8.15-7 9.75-4.05-1.6-7-5.35-7-9.75V6l7-3Z" /><path d="M12 8.5v4M12 15.75h.01" /></>}
  {name === 'cursor' && <path d="M6 4.5 18.5 11l-5.6 1.55L10.6 18 6 4.5Z" />}
  {name === 'swipe' && <path d="M4 12h15M15 8l4 4-4 4M4 8v8" />}
  {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.25" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.1-3.6-8.5S9.6 5.8 12 3.5Z" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
</svg>
