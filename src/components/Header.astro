---
import Icon from '@/components/ui/Icon.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import { alternatePath, copy, withLocale, type Locale } from '@/data/content';

interface Props {
  locale: Locale;
  routePath: string;
}

const { locale, routePath } = Astro.props;
const t = copy[locale];
const pt = locale === 'pt';
const items = [
  ['work', t.nav.work],
  ['services', t.nav.services],
  ['about', t.nav.about],
] as const;
const isCurrent = (path: string) => routePath === path || routePath.startsWith(`${path}/`);
const otherLocale = pt ? 'en' : 'pt-BR';
---

<header class="site-header" data-site-header>
  <div class="site-header__inner shell">
    <a class="brand" href={withLocale(locale)}>
      <svg class="brand__glyph" viewBox="0 0 26 26" fill="none" aria-hidden="true" focusable="false">
        <rect x="1.75" y="3.75" width="22.5" height="18.5" rx="4.25" stroke="currentColor" stroke-width="1.5" />
        <path d="M1.75 9.25h22.5" stroke="currentColor" stroke-width="1.5" />
        <circle class="brand__glyph-dot" cx="5.75" cy="6.5" r="1.25" />
        <path d="M10 19.5V12h3.25a2.25 2.25 0 0 1 0 4.5H10m2.9 0 3.1 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <Wordmark label={pt ? 'página inicial' : 'home'} />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden data-menu-toggle>
      <span>Menu</span>
      <span class="menu-toggle__lines" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label={pt ? 'Navegação principal' : 'Primary navigation'} data-site-nav>
      <ul class="site-nav__list">
        {items.map(([path, label]) => (
          <li><a href={withLocale(locale, path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
      <div class="site-nav__actions">
        <a class="locale-switch" href={routePath === '404' ? withLocale(locale === 'pt' ? 'en' : 'pt') : alternatePath(locale, routePath)} lang={otherLocale} hreflang={otherLocale}>
          <Icon name="globe" />{t.switchLocale}
        </a>
        <a class="button button--primary button--small" href={withLocale(locale, 'contact')} aria-current={isCurrent('contact') ? 'page' : undefined}>{t.nav.contact}</a>
      </div>
    </nav>
  </div>
  <div class="site-header__scrim" hidden data-menu-scrim></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');

  if (header) {
    let ticking = false;
    const update = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }

  if (header && toggle && nav && scrim) {
    toggle.hidden = false;
    nav.setAttribute('data-enhanced', '');
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      header.toggleAttribute('data-menu-open', open);
      scrim.hidden = !open;
      // The page behind the open menu does not scroll; the panel scrolls on its own when it is taller.
      document.documentElement.toggleAttribute('data-menu-open', open);
    };
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    scrim.addEventListener('click', () => setOpen(false));
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    // Tabbing past the last menu link closes the panel, so focus never wanders behind the scrim.
    header.addEventListener('focusout', (event) => {
      if (isOpen() && event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
    });
    window.matchMedia('(min-width: 52em)').addEventListener('change', (query) => {
      if (query.matches) setOpen(false);
    });
  }
</script>
