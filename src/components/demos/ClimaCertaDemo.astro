---
import DemoBar from '@/components/demos/DemoBar.astro';
import { localize, withLocale, type Concept, type DemoProject, type Locale } from '@/data/content';

interface Props { locale: Locale; concept: Concept; project: DemoProject }

const { locale, concept, project } = Astro.props;
const pt = locale === 'pt';
const demoImage = concept.image.replace(/\.png$/, '.webp');
const serviceIcons = ['↗', '⌁', '＋'];
const t = pt
  ? {
      nav: 'Navegação Clima Certa',
      tagline: 'climatização, com clareza',
      services: 'Serviços',
      process: 'Como funciona',
      request: 'Pedir orçamento',
      heroKicker: 'Instalação · manutenção · conserto',
      heroLede: 'Ar-condicionado instalado, revisado ou consertado sem enrolação. Conte o que está acontecendo e o técnico já chega sabendo o que levar.',
      heroCta: 'Montar meu pedido',
      heroCaption: 'Conforto começa no ambiente',
      servicesKicker: 'O que você precisa?',
      servicesTitle: 'Cada ambiente pede uma solução.',
      servicesLede: 'Escolha o caso mais parecido com o seu. A conversa começa a partir dele.',
      serviceLabels: ['APARELHO NOVO', 'CUIDADO CONTÍNUO', 'ALGO NÃO VAI BEM'],
      serviceActions: ['Descrever o ambiente', 'Agendar uma revisão', 'Contar o problema'],
      processKicker: 'Sem surpresa no dia',
      processTitle: 'Do primeiro contato à visita.',
      steps: [
        { title: 'Conte o que precisa', text: 'Tipo de serviço, tamanho do ambiente e o que você já percebeu no aparelho.' },
        { title: 'Receba as opções', text: 'O técnico responde com o que faz sentido para o seu caso e uma estimativa de valor.' },
        { title: 'Marque a visita', text: 'Você escolhe o melhor dia e o técnico chega com o material certo.' },
      ],
      requestKicker: 'Seu pedido em um minuto',
      requestTitle: 'O que está acontecendo no seu espaço?',
      requestLede: 'Escolha o tipo de serviço e descreva em poucas palavras. Assim o primeiro contato já começa com contexto.',
      requestNote: 'Demonstração local: não calcula capacidade, não verifica agenda e não envia seus dados.',
      plannerGroup: 'Rascunho do pedido',
      kindLabel: 'Qual é o serviço?',
      kindPlaceholder: 'Escolha uma opção',
      kinds: ['Instalação nova', 'Manutenção', 'Conserto', 'Ainda não sei'],
      noteLabel: 'O que você observou?',
      notePlaceholder: 'Ex.: o quarto recebe sol à tarde e o aparelho está pingando.',
      submit: 'Montar rascunho',
      status: 'Escolha uma opção e escreva uma observação. Nenhum dado será enviado.',
      noscript: 'O rascunho interativo precisa de JavaScript. O conteúdo da página continua disponível.',
      labels: { kind: 'Serviço', note: 'Observação', empty: 'Escolha uma opção e escreva uma observação.', ready: 'Rascunho local:' },
      contact: 'Fale com Rafael',
      back: 'Voltar ao portfólio',
    }
  : {
      nav: 'Clima Certa navigation',
      tagline: 'climate comfort, clearly',
      services: 'Services',
      process: 'How it works',
      request: 'Request a quote',
      heroKicker: 'Installation · maintenance · repair',
      heroLede: 'Air conditioning installed, serviced, or repaired without the runaround. Tell us what is happening and the technician arrives knowing what to bring.',
      heroCta: 'Start my request',
      heroCaption: 'Comfort begins with the space',
      servicesKicker: 'What do you need?',
      servicesTitle: 'Every space needs its own solution.',
      servicesLede: 'Pick the case closest to yours. The conversation starts from there.',
      serviceLabels: ['NEW UNIT', 'ONGOING CARE', 'SOMETHING IS WRONG'],
      serviceActions: ['Describe the space', 'Book a service visit', 'Describe the problem'],
      processKicker: 'No surprises on the day',
      processTitle: 'From first contact to the visit.',
      steps: [
        { title: 'Tell us what you need', text: 'Type of service, room size, and anything you have noticed about the unit.' },
        { title: 'Get your options', text: 'The technician replies with what makes sense for your case and an estimated price.' },
        { title: 'Book the visit', text: 'You pick the day and the technician arrives with the right parts.' },
      ],
      requestKicker: 'Your request in a minute',
      requestTitle: 'What is happening in your space?',
      requestLede: 'Choose the type of service and describe it in a few words, so the first conversation starts with context.',
      requestNote: 'Local demo: it does not size equipment, check a schedule, or send your details.',
      plannerGroup: 'Request draft',
      kindLabel: 'Which service?',
      kindPlaceholder: 'Choose an option',
      kinds: ['New installation', 'Maintenance', 'Repair', 'Not sure yet'],
      noteLabel: 'What have you noticed?',
      notePlaceholder: 'For example: the bedroom gets afternoon sun and the unit is dripping.',
      submit: 'Build my draft',
      status: 'Choose an option and add a note. Nothing will be sent.',
      noscript: 'The interactive draft needs JavaScript. The rest of the page remains available.',
      labels: { kind: 'Service', note: 'Note', empty: 'Choose an option and add a note.', ready: 'Your local draft:' },
      contact: 'Contact Rafael',
      back: 'Back to portfolio',
    };
---

<DemoBar locale={locale} project={project} />
<article class="demo demo--clima">
  <nav class="clima-nav" aria-label={t.nav}>
    <a class="clima-brand" href="#clima-inicio">
      <span class="clima-brand__mark" aria-hidden="true">CC</span>
      <span>clima certa<small>{t.tagline}</small></span>
    </a>
    <div class="clima-nav__links">
      <a href="#clima-servicos">{t.services}</a>
      <a href="#clima-processo">{t.process}</a>
      <a class="clima-nav__cta" href="#clima-pedido">{t.request}</a>
    </div>
  </nav>

  <header id="clima-inicio" class="clima-hero">
    <div class="clima-hero__copy">
      <p class="demo-kicker">{t.heroKicker}</p>
      <h1>{localize(concept.demoTagline, locale)}</h1>
      <p>{t.heroLede}</p>
      <a class="clima-button" href="#clima-pedido">{t.heroCta} <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="clima-hero__visual">
      <img src={demoImage} alt={localize(concept.imageAlt, locale)} width={concept.imageWidth} height={concept.imageHeight} fetchpriority="high" />
      <figcaption><span>01</span> / {t.heroCaption}</figcaption>
    </figure>
    <div class="clima-hero__grid" aria-hidden="true"></div>
  </header>

  <section id="clima-servicos" class="clima-services demo-shell">
    <div class="clima-section-head">
      <p class="demo-kicker">{t.servicesKicker}</p>
      <h2>{t.servicesTitle}</h2>
      <p>{t.servicesLede}</p>
    </div>
    <div class="clima-service-grid">
      {concept.sections[locale].map((section, index) => (
        <article>
          <span class="clima-service-icon" aria-hidden="true">{serviceIcons[index]}</span>
          <p class="clima-service-index">{String(index + 1).padStart(2, '0')} / {t.serviceLabels[index]}</p>
          <h3>{section.title}</h3>
          <p>{section.text}</p>
          <a href="#clima-pedido">{t.serviceActions[index]} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section id="clima-processo" class="clima-process">
    <div class="demo-shell">
      <div class="clima-section-head">
        <p class="demo-kicker">{t.processKicker}</p>
        <h2>{t.processTitle}</h2>
      </div>
      <ol class="clima-steps">
        {t.steps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="clima-pedido" class="clima-request">
    <div class="demo-shell clima-request__inner">
      <div>
        <p class="demo-kicker">{t.requestKicker}</p>
        <h2>{t.requestTitle}</h2>
        <p>{t.requestLede}</p>
        <p class="demo-local-note">{t.requestNote}</p>
      </div>
      <div
        role="group"
        aria-label={t.plannerGroup}
        class="demo-planner clima-planner"
        data-demo-planner
        data-label-kind={t.labels.kind}
        data-label-note={t.labels.note}
        data-label-empty={t.labels.empty}
        data-label-ready={t.labels.ready}
      >
        <label>
          {t.kindLabel}
          <select name="kind">
            <option value="">{t.kindPlaceholder}</option>
            {t.kinds.map((kind) => <option>{kind}</option>)}
          </select>
        </label>
        <label>
          {t.noteLabel}
          <textarea name="note" rows="4" maxlength="240" placeholder={t.notePlaceholder}></textarea>
        </label>
        <button type="button" data-demo-update>{t.submit}</button>
        <p class="demo-planner__status" role="status" aria-live="polite">{t.status}</p>
        <noscript><p class="demo-noscript">{t.noscript}</p></noscript>
      </div>
    </div>
  </section>

  <footer class="demo-footer clima-footer">
    <a class="clima-brand" href="#clima-inicio">
      <span class="clima-brand__mark" aria-hidden="true">CC</span>
      <span>clima certa<small>{t.tagline}</small></span>
    </a>
    <a href={withLocale(locale, 'contact')}>{t.contact}</a>
    <a class="demo-back" href={withLocale(locale, 'work')}>{t.back}</a>
  </footer>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-demo-planner]').forEach((planner) => {
    planner.querySelector<HTMLButtonElement>('[data-demo-update]')?.addEventListener('click', () => {
      const status = planner.querySelector<HTMLElement>('[role="status"]');
      if (!status) return;
      const kind = planner.querySelector<HTMLSelectElement>('[name="kind"]')?.value.trim() || '';
      const note = planner.querySelector<HTMLTextAreaElement>('[name="note"]')?.value.trim() || '';
      if (!kind || !note) {
        status.textContent = planner.dataset.labelEmpty || '';
        return;
      }
      status.textContent = `${planner.dataset.labelReady || ''} ${planner.dataset.labelKind}: ${kind} · ${planner.dataset.labelNote}: ${note}`;
    });
  });
</script>
