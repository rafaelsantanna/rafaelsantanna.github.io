    };

const say = t.modalitySay as Record<string, string>;
const beltIds = ['branca', 'azul', 'roxa', 'marrom', 'preta'];
const pad = (n: number) => String(n + 1).padStart(2, '0');
const logo = '<rect width="40" height="40" rx="7" fill="#D02B1E"/><path d="M9 20.5 20 11l11 9.5M9 29.5 20 20l11 9.5" fill="none" stroke="#fff" stroke-width="4.2" stroke-linecap="square"/>';
---

<DemoBar locale={locale} project={project} />
<article class="demo demo--guarda">
  <header class="ga-header" data-ga-header>
    <nav class="ga-header__inner" aria-label={t.nav}>
      <a class="ga-brand" href="#ga-inicio">
        <svg class="ga-brand__mark" viewBox="0 0 40 40" aria-hidden="true" set:html={logo} />
        <span>Guarda Alta<small>{t.tagline}</small></span>
      </a>
      <div class="ga-header__links">
        {t.links.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>
      <a class="ga-pill ga-pill--small" href="#ga-agendar">{t.navCta}</a>
    </nav>
  </header>

  <section id="ga-inicio" class="ga-hero ga-dark" aria-labelledby="ga-h1">
    <span class="ga-sentinel" data-ga-sentinel aria-hidden="true"></span>
    <figure class="ga-hero__photo">
      <img src="/images/concepts/academia-luta-hero.webp" alt={t.heroAlt} width="1024" height="688" fetchpriority="high" />
    </figure>
    <div class="ga-shell ga-hero__content">
      <p class="ga-eyebrow">{t.heroEyebrow}</p>
      <h1 id="ga-h1" class="ga-hero__title">
        <span class="ga-hero__line">{t.h1[0]}</span>{' '}
        <span class="ga-hero__line">{t.h1[1]}</span>{' '}
        <span class="ga-hero__line"><span class="ga-accent"><span>{t.h1[2]}</span></span></span>
      </h1>
      <p class="ga-hero__lede">{t.heroLede}</p>
      <div class="ga-hero__actions">
        <a class="ga-pill" href="#ga-agendar">{t.heroCta}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg></a>
        <a class="ga-link" href="#ga-horarios">{t.heroSecondary}</a>
      </div>
      <ul class="ga-facts">
        {t.facts.map((fact) => <li><strong>{fact.value}</strong><span>{fact.label}</span></li>)}
      </ul>
    </div>
    <div class="ga-sticker" aria-hidden="true">
      <svg class="ga-sticker__ring" viewBox="0 0 140 140"><defs><path id="ga-ring" d="M70 70m-55 0a55 55 0 1 1 110 0a55 55 0 1 1-110 0" /></defs><text><textPath href="#ga-ring" textLength="340">{t.ring}</textPath></text></svg>
      <span class="ga-sticker__center"><b>{t.ringCenter[0]}</b>{t.ringCenter[1]}</span>
    </div>
    <div class="ga-beltline" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </section>

  <div class="ga-marquee" aria-hidden="true">
    <div class="ga-marquee__track">
      {[0, 1].map(() => (
        <span class="ga-marquee__group">{t.marquee.map((item) => <><span>{item}</span><svg viewBox="0 0 20 20"><path d="M10 1 19 10 10 19 1 10Z" /></svg></>)}</span>
      ))}
    </div>
  </div>

  <section id="ga-modalidades" class="ga-mods ga-light ga-torn" aria-labelledby="ga-mods-title">
    <div class="ga-shell ga-mods__grid">
      <div class="ga-mods__aside">
        <p class="ga-eyebrow">{t.modEyebrow}</p>
        <h2 id="ga-mods-title" class="ga-title">{t.modTitle[0]} <span>{t.modTitle[1]}</span></h2>
        <p class="ga-lede">{t.modLede}</p>
        <figure class="ga-print" data-reveal>
          <img src="/images/concepts/academia-luta-muaythai.webp" alt={t.mtAlt} width="896" height="1120" loading="lazy" />
          <figcaption>{t.mtCaption}</figcaption>
        </figure>
      </div>
      <ol class="ga-mods__list">
        {t.modItems.map((item, index) => (
          <li class="ga-mod" data-reveal>
            <span class="ga-mod__num" aria-hidden="true">{pad(index)}</span>
            <div class="ga-mod__body">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              <ul class="ga-tags">{item.tags.map((tag) => <li>{tag}</li>)}</ul>
              <a class="ga-arrow" href="#ga-horarios" data-ga-show={item.id}>{t.showTimes}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg></a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="ga-horarios" class="ga-schedule ga-dark" aria-labelledby="ga-sched-title" data-ga-schedule>
    <div class="ga-shell">
      <div class="ga-head">
        <div>
          <p class="ga-eyebrow">{t.schedEyebrow}</p>
          <h2 id="ga-sched-title" class="ga-title">{t.schedTitle[0]} <span>{t.schedTitle[1]}</span></h2>
        </div>
        <p class="ga-lede">{t.schedLede}</p>
      </div>
      <div class="ga-filters" role="group" aria-label={t.filtersLabel}>
        <fieldset class="ga-chips">
          <legend>{t.modLegend}</legend>
          <label><input type="radio" name="ga-mod" value="all" checked /><span>{t.all}</span></label>
          {modalities.map((mod) => <label><input type="radio" name="ga-mod" value={mod.id} /><span>{mod.name[locale]}</span></label>)}
        </fieldset>
        <fieldset class="ga-chips">
          <legend>{t.levelLegend}</legend>
          <label><input type="radio" name="ga-level" value="all" checked /><span>{t.anyLevel}</span></label>
          {levels.map((level) => <label><input type="radio" name="ga-level" value={level.id} /><span>{level.name[locale]}</span></label>)}
        </fieldset>
      </div>
      <p class="ga-count" role="status" aria-live="polite" data-ga-count data-all={t.count.all} data-some={t.count.some} data-none={t.count.none}>{t.count.all.replace('{n}', String(weeklyClassCount))}</p>
      <fieldset class="ga-days" data-ga-days hidden>
        <legend class="ga-sr">{t.dayLegend}</legend>
        {days.map((day) => <label><input type="radio" name="ga-day" value={day.id} /><span>{day.short[locale]}<small data-ga-daycount={day.id}></small></span></label>)}
      </fieldset>
      <div class="ga-week" data-ga-week>
        {periods.map((period, index) => <p class="ga-week__period" style={`grid-row: ${index + 2}`} aria-hidden="true">{period.name[locale]}</p>)}
        {days.map((day) => (
          <section class="ga-day" data-ga-day={day.id} aria-label={day.name[locale]}>
            <h3 class="ga-day__name">{day.name[locale]}</h3>
            {periods.map((period) => {
              const list = classesFor(day.id, period.id);
              return (
                <div class="ga-day__slot">
                  {list.length > 0 && <p class="ga-day__period">{period.name[locale]}</p>}
                  {list.map((cell) => {
                    const mod = modalities.find((item) => item.id === cell.modality)!.name[locale];
                    const level = levels.find((item) => item.id === cell.level)!.name[locale];
                    const detail = cell.note ? cell.note[locale] : level;
                    return (
                      <button type="button" class="ga-class" data-ga-class data-mod={cell.modality} data-level={cell.level} data-day={day.id} data-slot={`${day.name[locale]}, ${cell.time} (${mod}, ${detail.toLowerCase()})`}>
                        <span class="ga-sr">{day.name[locale]},</span>
                        <span class="ga-class__time">{cell.time}</span>
                        <span class="ga-class__mod">{mod}</span>
                        <span class="ga-class__meta">{detail} · {cell.minutes} {t.minutes}</span>
                        <span class="ga-class__cta">{t.tryCta}</span>
                      </button>
                    );
                  })}
                </div>
              );
            })}
            <p class="ga-day__empty">{t.dayEmpty}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="ga-primeira-aula" class="ga-first ga-light ga-torn" aria-labelledby="ga-first-title">
    <div class="ga-shell">
      <div class="ga-head">
        <div>
          <p class="ga-eyebrow">{t.firstEyebrow}</p>
          <h2 id="ga-first-title" class="ga-title">{t.firstTitle[0]} <span>{t.firstTitle[1]}</span></h2>
        </div>
        <p class="ga-lede">{t.firstLede}</p>
      </div>
      <div class="ga-tabs" data-ga-tabs>
        <div class="ga-tabs__list" role="tablist" aria-label={t.tabsLabel} hidden>
          {t.tabs.map((tab, index) => <button type="button" role="tab" id={`ga-tab-${tab.id}`} aria-controls={`ga-panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'}>{tab.tab}</button>)}
        </div>
        {t.tabs.map((tab) => (
          <div class="ga-panel" role="tabpanel" id={`ga-panel-${tab.id}`} aria-labelledby={`ga-tab-${tab.id}`}>
            <figure class="ga-panel__photo">
              <img src={tab.image} alt={tab.alt} width="896" height="1120" loading="lazy" />
              <figcaption class="ga-tape">{tab.tape}</figcaption>
            </figure>
            <div class="ga-panel__body">
              <h3 class="ga-panel__title">{tab.tab}</h3>
              <ol class="ga-steps">
                {tab.steps.map(([title, text], index) => <li><span aria-hidden="true">{pad(index)}</span><div><h4>{title}</h4><p>{text}</p></div></li>)}
              </ol>
              <div class="ga-bring">
                <h4>{t.bringTitle}</h4>
                <ul>{tab.bring.map((item) => <li>{item}</li>)}</ul>
              </div>
              <a class="ga-pill" href="#ga-agendar">{t.firstCta}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="ga-faixas" class="ga-belts ga-dark" aria-labelledby="ga-belts-title">
    <div class="ga-shell">
      <div class="ga-head">
        <div>
          <p class="ga-eyebrow">{t.beltEyebrow}</p>
          <h2 id="ga-belts-title" class="ga-title">{t.beltTitle[0]} <span>{t.beltTitle[1]}</span></h2>
        </div>
        <p class="ga-lede">{t.beltLede}</p>
      </div>
      <ol class="ga-belt-list">
        {t.belts.map((belt, index) => (
          <li class={`ga-belt-row ga-belt-row--${beltIds[index]}`} style={`--w: ${52 + index * 12}%`}>
            <span class="ga-belt" aria-hidden="true"><span class="ga-belt__tip">{Array.from({ length: index === 4 ? 0 : index % 4 + 1 }).map(() => <i></i>)}</span></span>
            <div class="ga-belt-row__text">
              <h3><span aria-hidden="true">{pad(index)}</span> {belt.name}</h3>
              <p class="ga-belt-row__time">{belt.time}</p>
              <p>{belt.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <ul class="ga-belt-notes">{t.beltNotes.map((note) => <li>{note}</li>)}</ul>
    </div>
  </section>

  <section id="ga-planos" class="ga-plans ga-light ga-torn" aria-labelledby="ga-plans-title">
    <span class="ga-watermark" aria-hidden="true">OSS</span>
    <div class="ga-shell">
      <p class="ga-eyebrow">{t.planEyebrow}</p>
      <h2 id="ga-plans-title" class="ga-title">{t.planTitle[0]} <span>{t.planTitle[1]}</span></h2>
      <ul class="ga-plan-list">
        {t.plans.map((plan) => (
          <li class:list={['ga-plan', { 'ga-plan--hot': 'tag' in plan }]} data-reveal>
            {'tag' in plan && <p class="ga-plan__tag">{plan.tag}</p>}
            <h3>{plan.name}</h3>
            <p class="ga-plan__sub">{plan.sub}</p>
            <p class="ga-plan__price"><small>{t.from}</small> <span>R$ <b>{plan.price}</b></span><small>{t.perMonth}</small></p>
            <ul class="ga-checks">{plan.items.map((item) => <li>{item}</li>)}</ul>
          </li>
        ))}
      </ul>
      <div class="ga-plans__foot">
        <p>{t.planNote}</p>
        <a class="ga-pill ga-pill--dark" href="#ga-agendar">{t.planCta}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg></a>
      </div>
    </div>
  </section>

  <section id="ga-regras" class="ga-rules ga-dark" aria-labelledby="ga-rules-title">
    <div class="ga-shell">
      <p class="ga-eyebrow">{t.rulesEyebrow}</p>
      <h2 id="ga-rules-title" class="ga-title">{t.rulesTitle[0]} <span>{t.rulesTitle[1]}</span></h2>
      <ol class="ga-rule-list">
        {t.rules.map(([title, text], index) => <li data-reveal><span aria-hidden="true">{pad(index)}</span><h3>{title}</h3><p>{text}</p></li>)}
      </ol>
    </div>
  </section>

  <section id="ga-duvidas" class="ga-faq ga-light ga-torn" aria-labelledby="ga-faq-title">
    <div class="ga-shell ga-faq__grid">
      <h2 id="ga-faq-title" class="ga-title">{t.faqTitle[0]} <span>{t.faqTitle[1]}</span></h2>
      <div class="ga-faq__list">
        {t.faqs.map((item) => (
          <details>
            <summary>{item.q}<span class="ga-faq__icon" aria-hidden="true"></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="ga-agendar" class="ga-book" aria-labelledby="ga-book-title">
    <div class="ga-shell ga-book__grid">
      <div class="ga-book__copy">
        <p class="ga-eyebrow">{t.bookEyebrow}</p>
        <h2 id="ga-book-title" class="ga-title">{t.bookTitle[0]} <span>{t.bookTitle[1]}</span></h2>
        <p class="ga-lede">{t.bookLede}</p>
        <h3 class="ga-next__title">{t.nextTitle}</h3>
        <ol class="ga-next">{t.nextSteps.map((step, index) => <li><span aria-hidden="true">{pad(index)}</span>{step}</li>)}</ol>
        <div class="ga-beltline ga-beltline--short" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
      <div
        class="ga-builder"
        role="group"
        aria-label={t.builderLabel}
        data-ga-builder
        data-greeting={t.msg.greeting}
        data-want={t.msg.want}
        data-slot={t.msg.slot}
        data-no-slot={t.msg.noSlot}
        data-closing={t.msg.closing}
        data-empty={t.msg.empty}
        data-ready={t.msg.ready}
        data-copy={t.copy}
        data-copied={t.copied}
        data-copy-failed={t.copyFailed}
      >
        <label class="ga-field">
          <span>{t.nameLabel}</span>
          <input type="text" name="ga-name" autocomplete="given-name" maxlength="60" placeholder={t.namePlaceholder} />
        </label>
        <fieldset class="ga-chips ga-chips--light">
          <legend>{t.ageLegend}</legend>
          {t.ages.map(([value, label, phrase], index) => <label><input type="radio" name="ga-age" value={value} data-say={phrase} checked={index === 0} /><span>{label}</span></label>)}
        </fieldset>
        <fieldset class="ga-chips ga-chips--light">
          <legend>{t.expLegend}</legend>
          {t.exps.map(([value, label, phrase], index) => <label><input type="radio" name="ga-exp" value={value} data-say={phrase} checked={index === 0} /><span>{label}</span></label>)}
        </fieldset>
        <fieldset class="ga-chips ga-chips--light">
          <legend>{t.modalityLegend}</legend>
          {modalities.map((mod) => <label><input type="radio" name="ga-modality" value={mod.id} data-say={say[mod.id]} /><span>{mod.name[locale]}</span></label>)}
        </fieldset>
        <label class="ga-field">
          <span>{t.slotLabel}</span>
          <input type="text" name="ga-slot" maxlength="80" placeholder={t.slotPlaceholder} />
        </label>
        <button type="button" class="ga-pill ga-pill--dark ga-builder__build" data-ga-build>{t.build}</button>
        <p class="ga-bubble" role="status" aria-live="polite" data-ga-message>{t.statusIdle}</p>
        <button type="button" class="ga-copy" data-ga-copy hidden>{t.copy}</button>
        <p class="ga-builder__note">{t.bookNote}</p>
        <noscript><p class="demo-noscript">{t.noscript}</p></noscript>
      </div>
    </div>
  </section>

  <footer class="ga-footer ga-dark">
    <div class="ga-shell ga-footer__inner">
      <a class="ga-brand" href="#ga-inicio">
        <svg class="ga-brand__mark" viewBox="0 0 40 40" aria-hidden="true" set:html={logo} />
        <span>Guarda Alta<small>{t.tagline}</small></span>
      </a>
      <p>{t.footerLine}</p>
      <div class="ga-footer__links">
        <a href={withLocale(locale, 'contact')}>{t.contact}</a>
        <a href={withLocale(locale, 'work')}>{t.back}</a>
      </div>
    </div>
  </footer>
</article>

<script>
  import { initGuardaAlta } from '@/components/demos/academia-luta/client';
  initGuardaAlta();
</script>
