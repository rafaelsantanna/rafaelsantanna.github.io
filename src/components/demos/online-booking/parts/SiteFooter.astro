---
import type { Locale } from '@/data/types';
import { strings } from '../data/i18n';
import { icons } from '../lib/icons';
import BrandMark from './BrandMark.astro';

interface Props { locale: Locale }

const t = strings[Astro.props.locale];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <BrandMark href="#topo" label={t.brand.home} kind={t.brand.kind} />
    <p class="site-footer__note">{t.footer.note}</p>
    <div class="site-footer__reset">
      <button type="button" class="text-btn" data-reset-demo><Fragment set:html={icons.reset} />{t.footer.reset}</button>
      <p>{t.footer.resetHint}</p>
    </div>
  </div>
</footer>
