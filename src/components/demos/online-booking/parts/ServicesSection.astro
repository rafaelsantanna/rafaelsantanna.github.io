---
import type { Locale } from '@/data/types';
import { localizedServices } from '../data/catalog';
import { strings } from '../data/i18n';
import { createFormat, fill } from '../lib/format';
import { icons, serviceIcon } from '../lib/icons';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = strings[locale];
const fmt = createFormat(t.intl, t.client.format);
const services = localizedServices(locale);
---

<section class="services paper" id="servicos" aria-labelledby="cp-services-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <h2 id="cp-services-title">{t.services.title}</h2>
      <p class="section-head__lede">{t.services.lede}</p>
    </header>
    <ul class="menu" role="list">
      {services.map((service) => (
        <li class="menu__item">
          <span class="menu__icon" aria-hidden="true"><Fragment set:html={serviceIcon(service.id)} /></span>
          <div class="menu__body">
            <h3 class="menu__name">{service.name}</h3>
            <p class="menu__desc">{service.description}</p>
            <p class="menu__time"><Fragment set:html={icons.clock} /><span class="sr-only">{t.services.duration}: </span>{fmt.minutes(service.duration)}</p>
          </div>
          <div class="menu__side">
            <p class="menu__price"><span class="sr-only">{t.services.price}: </span>{fmt.price(service.price)}</p>
            <a class="menu__book" href="#agendar" data-book data-book-service={service.id} aria-label={fill(t.services.bookLabel, { service: service.name })}>
              {t.services.book}<Fragment set:html={icons.arrow} />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
