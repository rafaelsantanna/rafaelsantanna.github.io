---
interface Props { class?: string }

const { class: className } = Astro.props;
---

<svg class:list={['ka-mark', className]} viewBox="0 0 32 32" aria-hidden="true" focusable="false" data-ka-mark>
  <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
  <path d="M16 2.5v3M16 26.5v3M2.5 16h3M26.5 16h3" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round" />
  <path d="M16 6.5 19.4 16h-6.8z" fill="var(--ka-yellow)" />
  <path d="M16 25.5 12.6 16h6.8z" fill="currentColor" fill-opacity="0.55" />
  <circle cx="16" cy="16" r="1.6" fill="var(--ka-base)" />
</svg>
