---
interface Props { class?: string }

const { class: className } = Astro.props;
---

<svg class:list={['ka-mark', className]} viewBox="0 0 32 32" aria-hidden="true" focusable="false" data-ka-mark>
  <circle cx="16" cy="16" r="14.25" fill="none" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.25" />
  <path d="M16 3v2.6M16 26.4V29M3 16h2.6M26.4 16H29" stroke="currentColor" stroke-opacity="0.42" stroke-width="1.25" stroke-linecap="round" />
  <g class="ka-mark__needle">
    <path d="M16 6.2 19.2 16h-6.4z" fill="var(--ka-gold)" />
    <path d="M16 25.8 12.8 16h6.4z" fill="currentColor" fill-opacity="0.5" />
  </g>
  <circle cx="16" cy="16" r="1.5" fill="var(--ka-base)" />
</svg>
