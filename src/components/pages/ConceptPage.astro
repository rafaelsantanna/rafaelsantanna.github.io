---
import { type Concept, type Locale } from '@/data/content';
import CasaNeblinaDemo from '@/components/demos/CasaNeblinaDemo.astro';
import ClimaCertaDemo from '@/components/demos/ClimaCertaDemo.astro';
import '@/styles/demos.css';
interface Props { locale: Locale; concept: Concept }
const { locale, concept } = Astro.props;
---

{concept.theme === 'hospitality' ? <CasaNeblinaDemo locale={locale} concept={concept} /> : <ClimaCertaDemo locale={locale} concept={concept} />}
