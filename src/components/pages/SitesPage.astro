---
import Icon from '@/components/ui/Icon.astro';
import NicheCard from '@/components/sites/NicheCard.astro';
import OfferBox from '@/components/sites/OfferBox.astro';
import SitesFaq from '@/components/sites/SitesFaq.astro';
import { identity, withLocale, type Locale } from '@/data/content';
import { niches, sitesCopy, whatsappLink } from '@/data/small-business';

interface Props { locale: Locale }

const { locale } = Astro.props;
const pt = locale === 'pt';
const c = sitesCopy[locale];
const whatsapp = whatsappLink(identity.phoneE164, locale);
const ids = pt ? { segments: 'segmentos', how: 'como-funciona' } : { segments: 'segments', how: 'how-it-works' };
const ui = pt
  ? {
      seeModels: 'Ver modelos por segmento',
      talk: 'Chamar no WhatsApp',
      segmentsIndex: 'Modelos por segmento',
      segmentsTitle: 'Abra no celular e imagine o seu.',
      segmentsLede: 'Cada modelo funciona de verdade, com marca e dados de exemplo. No seu entram o seu nome, os seus serviços, as suas fotos e o botão cai no seu WhatsApp.',
      howIndex: 'Como funciona',
      systemsTitle: 'Precisa de mais que uma página?',
      systemsLink: 'Ver sistemas e apps',
      closeTitle: 'Vamos colocar o seu negócio na internet?',
      closeText: 'Me chama no WhatsApp com o nome da empresa e a cidade. Eu respondo com um modelo do seu ramo e o próximo passo.',
      email: 'Prefiro email',
    }
  : {
      seeModels: 'See models by segment',
      talk: 'Message me on WhatsApp',
      segmentsIndex: 'Models by segment',
      segmentsTitle: 'Open one on your phone and picture yours.',
      segmentsLede: 'Each model actually works, with a sample brand and data. Yours gets your name, your services, your photos, and a button that opens your WhatsApp.',
      howIndex: 'How it works',
      systemsTitle: 'Need more than a page?',
      systemsLink: 'See systems and apps',
      closeTitle: 'Shall we put your business online?',
      closeText: 'Message me on WhatsApp with your business name and city. I reply with a model from your field and the next step.',
      email: 'I prefer email',
    };
---

<article class="sites">
  <header class="sites-hero shell">
    <div class="sites-hero__copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="display-title">{c.heading}</h1>
      <p class="lede">{c.lede}</p>
      <div class="button-row">
        <a class="button button--primary" href={`#${ids.segments}`}>{ui.seeModels}<Icon name="arrow-down" /></a>
        <a class="button button--secondary" href={whatsapp} rel="noopener">{ui.talk}<Icon name="message" /></a>
      </div>
    </div>
    <OfferBox locale={locale} />
  </header>

  <section class="section" id={ids.segments} aria-labelledby="sites-segments-title">
    <div class="shell">
      <header class="section-head" data-reveal>
        <div class="section-head__title">
          <p class="section-index">{ui.segmentsIndex}</p>
          <h2 id="sites-segments-title">{ui.segmentsTitle}</h2>
        </div>
        <div class="section-head__aside">
          <p class="lede">{ui.segmentsLede}</p>
        </div>
      </header>
      <ul class="niche-grid niche-grid--lead">
        {niches.map((niche) => <li data-reveal><NicheCard niche={niche} locale={locale} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section sites-how" id={ids.how} aria-labelledby="sites-how-title">
    <div class="shell sites-how__inner">
      <header class="sites-how__head" data-reveal>
        <p class="section-index">{ui.howIndex}</p>
        <h2 id="sites-how-title">{c.howTitle}</h2>
      </header>
      <ol class="sites-steps">
        {c.steps.map((step, index) => (
          <li data-reveal>
            <span class="sites-steps__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="shell sites-callouts" aria-label={pt ? 'Outras opções' : 'Other options'}>
    <div class="callout" data-reveal>
      <Icon name="check" />
      <div>
        <h2>{c.audit.title}</h2>
        <p>{c.audit.text}</p>
      </div>
    </div>
    <div class="callout" data-reveal>
      <Icon name="shield" />
      <div>
        <h2>{ui.systemsTitle}</h2>
        <p>{c.engineer}</p>
        <a class="text-link" href={withLocale(locale, 'work')}>{ui.systemsLink}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <SitesFaq locale={locale} items={c.faq} id="sites-faq" />

  <section class="sites-close section" aria-labelledby="sites-close-title">
    <div class="shell sites-close__inner" data-reveal>
      <h2 id="sites-close-title">{ui.closeTitle}</h2>
      <p class="lede">{ui.closeText}</p>
      <div class="button-row">
        <a class="button button--primary" href={whatsapp} rel="noopener">{ui.talk}<Icon name="message" /></a>
        <a class="button button--secondary" href={`mailto:${identity.email}`}>{ui.email}<Icon name="mail" /></a>
      </div>
    </div>
  </section>
</article>
