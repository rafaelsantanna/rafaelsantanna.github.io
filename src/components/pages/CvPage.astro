---
import Icon from '@/components/ui/Icon.astro';
import { copy, experience, identity, localize, selectedWork, technologyName, timeline, type Locale } from '@/data/content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = copy[locale];
const pt = locale === 'pt';
const cvHref = identity.cv[locale];
const otherCvHref = identity.cv[pt ? 'en' : 'pt'];
const jobs = timeline.map((item) => {
  const detail = experience.find((entry) => entry.company === item.company);
  return {
    company: item.company,
    role: item.role[locale],
    period: detail ? localize(detail.period, locale).replace(' - ', ' – ') : item.period.replace('-', '–'),
    detail,
  };
});
const ownProduct = experience.find((entry) => entry.slug === 'edgedata');
// A no-break space keeps "Sant' Anna" together when the name wraps.
const displayName = identity.name.replace("' ", "'\u00A0");
const skills = pt
  ? [
      ['Frontend', 'React, React Native, Vue.js, AngularJS, TypeScript, JavaScript, HTML5, CSS3, Tailwind CSS'],
      ['Backend', 'Node.js, Laravel, PHP, .NET/C#, ASP.NET Core, ASP.NET MVC, APIs REST'],
      ['Bancos de dados', 'PostgreSQL, MySQL, SQL Server'],
      ['Mobile e automação', 'React Native, Ionic, RAG, assistentes inteligentes, bots para Telegram, automação de WhatsApp'],
    ]
  : [
      ['Frontend', 'React, React Native, Vue.js, AngularJS, TypeScript, JavaScript, HTML5, CSS3, Tailwind CSS'],
      ['Backend', 'Node.js, Laravel, PHP, .NET/C#, ASP.NET Core, ASP.NET MVC, REST APIs'],
      ['Databases', 'PostgreSQL, MySQL, SQL Server'],
      ['Mobile and automation', 'React Native, Ionic, RAG, intelligent assistants, Telegram bots, WhatsApp automation'],
    ];
const ui = pt
  ? {
      lede: 'Mais de 10 anos construindo plataformas SaaS, LMS/LXP, marketplaces, aplicações mobile, sistemas empresariais e automações com IA.',
      pdfMeta: 'PDF em português.',
      otherPdf: 'Versão em inglês (PDF)',
      print: 'Imprimir esta página',
      sheet: 'Currículo de Rafael Sant’ Anna',
      contact: 'Contato',
      languages: 'Idiomas',
      languageList: ['Português nativo', 'Inglês intermediário, B1'],
      availability: 'Disponibilidade',
      summary: 'Resumo',
      summaryText: 'Engenheiro de software sênior especializado em React, Vue.js, Laravel, Node.js, .NET/C#, React Native e arquiteturas orientadas a APIs. Experiência transformando operações complexas em produtos escaláveis, com foco em interfaces administrativas, integrações, relatórios, automação e RAG.',
      jobs: 'Experiência profissional',
      own: 'Produto próprio',
      others: 'Outros projetos',
      skills: 'Competências técnicas',
      education: 'Formação',
      degree: 'Bacharelado em Sistemas de Informação',
    }
  : {
      lede: 'More than 10 years building SaaS platforms, LMS/LXP products, marketplaces, mobile applications, enterprise systems, and AI automation.',
      pdfMeta: 'PDF in English.',
      otherPdf: 'Portuguese version (PDF)',
      print: 'Print this page',
      sheet: 'Rafael Sant’ Anna’s CV',
      contact: 'Contact',
      languages: 'Languages',
      languageList: ['Portuguese, native', 'English, intermediate B1'],
      availability: 'Availability',
      summary: 'Summary',
      summaryText: 'Senior software engineer specializing in React, Vue.js, Laravel, Node.js, .NET/C#, React Native, and API-oriented architectures. Experienced in turning complex operations into scalable products, with a focus on administrative interfaces, integrations, reporting, automation, and RAG.',
      jobs: 'Professional experience',
      own: 'Own product',
      others: 'Other projects',
      skills: 'Technical skills',
      education: 'Education',
      degree: 'Bachelor’s degree in Information Systems',
    };
const linkedinHandle = identity.linkedin.split('/in/')[1]?.replace(/\/$/, '') ?? '';
const githubLabel = identity.github.replace(/^https:\/\//, '');
---

<div class="cv" data-cv-page>
  <header class="cv-head shell">
    <div class="cv-head__text">
      <p class="section-index">CV</p>
      <h1>{t.cvTitle}</h1>
      <p class="lede">{ui.lede}</p>
    </div>
    <div class="cv-head__actions">
      <div class="button-row">
        <a class="button button--primary" href={cvHref} download>{t.downloadCv}<Icon name="download" /></a>
        <button class="button button--secondary" type="button" hidden data-print>{ui.print}</button>
      </div>
      <p class="small-meta">{ui.pdfMeta} <a href={otherCvHref} download hreflang={pt ? 'en' : 'pt-BR'}>{ui.otherPdf}</a></p>
    </div>
  </header>

  <article class="cv-sheet shell" aria-label={ui.sheet}>
    <aside class="cv-side">
      <div class="cv-side__inner">
        <div class="cv-id">
          <p class="cv-id__name">{displayName}</p>
          <p class="cv-id__role">{identity.role[locale]}</p>
          <p class="cv-id__place">{identity.location}</p>
        </div>
        <section class="cv-side__block" aria-labelledby="cv-contact">
          <h2 id="cv-contact" class="cv-side__title">{ui.contact}</h2>
          <ul class="cv-side__list">
            <li><a href={`mailto:${identity.email}`}>{identity.email}</a></li>
            <li><span class="cv-side__service">LinkedIn</span><a href={identity.linkedin} rel="me noreferrer">linkedin.com/in/<wbr />{linkedinHandle}</a></li>
            <li><span class="cv-side__service">GitHub</span><a href={identity.github} rel="me noreferrer">{githubLabel}</a></li>
          </ul>
        </section>
        <section class="cv-side__block" aria-labelledby="cv-languages">
          <h2 id="cv-languages" class="cv-side__title">{ui.languages}</h2>
          <ul class="cv-side__list">{ui.languageList.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section class="cv-side__block" aria-labelledby="cv-availability">
          <h2 id="cv-availability" class="cv-side__title">{ui.availability}</h2>
          <p class="cv-side__text">{identity.availability[locale]}.</p>
        </section>
      </div>
    </aside>

    <div class="cv-main">
      <section class="cv-section" aria-labelledby="cv-summary">
        <h2 id="cv-summary" class="cv-section__title">{ui.summary}</h2>
        <p class="cv-summary">{ui.summaryText}</p>
      </section>

      <section class="cv-section" aria-labelledby="cv-jobs">
        <h2 id="cv-jobs" class="cv-section__title">{ui.jobs}</h2>
        <ol class="cv-jobs">
          {jobs.map((job) => (
            <li class="cv-job">
              <div class="cv-job__head">
                <h3>{job.company}</h3>
                <p class:list={['cv-job__period', { 'cv-job__period--dated': /\d/.test(job.period) }]}>{job.period}</p>
                <p class="cv-job__role">{job.role}</p>
              </div>
              {job.detail && <p class="cv-job__summary">{localize(job.detail.summary, locale)}</p>}
              {job.detail && job.detail.outcomes[locale].length > 0 && <ul class="cv-job__outcomes">{job.detail.outcomes[locale].map((outcome) => <li>{outcome}</li>)}</ul>}
              {job.detail && job.detail.technologies.length > 0 && <p class="cv-job__stack">{job.detail.technologies.map((name) => technologyName(name, locale)).join(' · ')}</p>}
            </li>
          ))}
        </ol>
      </section>

      {ownProduct && <section class="cv-section" aria-labelledby="cv-own">
        <h2 id="cv-own" class="cv-section__title">{ui.own}</h2>
        <div class="cv-job">
          <div class="cv-job__head">
            <h3>{ownProduct.company}</h3>
            <p class="cv-job__period">{localize(ownProduct.period, locale)}</p>
            <p class="cv-job__role">{localize(ownProduct.role, locale)}</p>
          </div>
          <p class="cv-job__summary">{localize(ownProduct.summary, locale)}</p>
          <ul class="cv-job__outcomes">{ownProduct.outcomes[locale].map((outcome) => <li>{outcome}</li>)}</ul>
          <p class="cv-job__stack">{ownProduct.technologies.map((name) => technologyName(name, locale)).join(' · ')}</p>
        </div>
      </section>}

      <section class="cv-section" aria-labelledby="cv-others">
        <h2 id="cv-others" class="cv-section__title">{ui.others}</h2>
        <ul class="cv-others">
          {selectedWork.map((item) => <li><strong>{item.title}.</strong> {item.description[locale]}</li>)}
        </ul>
      </section>

      <section class="cv-section" aria-labelledby="cv-skills">
        <h2 id="cv-skills" class="cv-section__title">{ui.skills}</h2>
        <dl class="cv-skills">
          {skills.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </section>

      <section class="cv-section" aria-labelledby="cv-education">
        <h2 id="cv-education" class="cv-section__title">{ui.education}</h2>
        <div class="cv-job__head cv-education">
          <h3>{ui.degree}</h3>
          <p class="cv-job__period cv-job__period--dated">2014 – 2017</p>
          <p class="cv-job__role">Fundação Educacional Unificada Campograndense</p>
        </div>
      </section>
    </div>
  </article>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  });
</script>

<style>
  .cv-head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--space-6) var(--space-8);
    padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .cv-head__text { display: grid; gap: var(--space-5); min-width: 0; }
  .cv-head h1 { font-size: var(--step-6); font-weight: 700; letter-spacing: -0.052em; line-height: 0.98; }
  .cv-head__actions { display: grid; justify-items: start; gap: var(--space-3); min-width: 0; }
  .cv-head__actions .small-meta a { color: var(--text-soft); text-decoration-color: var(--violet-line); }
  .cv-head__actions .small-meta a:hover { color: var(--text); text-decoration-color: var(--violet); }

  .cv-sheet {
    display: grid;
    grid-template-columns: minmax(17.5rem, 0.34fr) minmax(0, 1fr);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-panel);
    background: var(--surface-1);
  }

  .cv-side { min-width: 0; padding: clamp(1.25rem, 0.25rem + 2vw, 2.75rem); border-inline-end: 1px solid var(--line); }
  .cv-side__inner { position: sticky; top: calc(var(--header-height) + 1.5rem); display: grid; align-content: start; gap: var(--space-6); }
  .cv-id { display: grid; gap: var(--space-1); }
  .cv-id__name { color: var(--text); font-family: var(--font-display); font-size: var(--step-2); font-weight: 700; letter-spacing: -0.035em; line-height: 1.15; }
  .cv-id__role { color: var(--text); font-family: var(--font-display); font-weight: 520; }
  .cv-id__place { color: var(--text-muted); font-size: var(--step--1); }
  .cv-side__block { display: grid; align-content: start; gap: var(--space-3); padding-block-start: var(--space-5); border-block-start: 1px solid var(--line); }
  .cv-side__title { color: var(--text-muted); font-size: var(--step--1); font-weight: 560; letter-spacing: 0; line-height: 1.3; }
  .cv-side__list { display: grid; gap: var(--space-2); list-style: none; color: var(--text-soft); font-size: 0.9375rem; }
  .cv-side__list li { display: grid; }
  .cv-side__list a {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 2.75rem;
    color: var(--text);
    overflow-wrap: anywhere;
    text-decoration-color: var(--violet-line);
  }
  .cv-side__list a:hover { text-decoration-color: var(--violet); }
  .cv-side__service { margin-block-end: -0.5rem; color: var(--text-muted); font-size: 0.8125rem; }
  .cv-side__text { color: var(--text-soft); font-size: 0.9375rem; line-height: 1.55; }

  .cv-main { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 3.5rem); min-width: 0; padding: clamp(1.5rem, 1rem + 3vw, 3.5rem); }
  .cv-section { display: grid; gap: var(--space-5); }
  .cv-section__title { font-size: var(--step-3); letter-spacing: var(--tracking-display); line-height: 1.1; }
  .cv-summary { max-width: 66ch; color: var(--text-soft); font-size: var(--step-1); line-height: 1.6; }

  .cv-jobs { display: grid; list-style: none; border-block-start: 1px solid var(--line); }
  .cv-jobs > .cv-job { padding-block: var(--space-6); border-block-end: 1px solid var(--line); }
  .cv-job { display: grid; gap: var(--space-3); }
  .cv-job__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
  }
  .cv-job__head h3 { font-size: var(--step-2); letter-spacing: -0.035em; line-height: 1.15; }
  .cv-job__period { color: var(--violet); font-family: var(--font-display); font-size: 0.8125rem; font-weight: 600; text-align: end; white-space: nowrap; }
  .cv-job__period--dated { font-family: var(--font-mono); font-weight: 500; font-variant-numeric: tabular-nums; }
  .cv-job__role { grid-column: 1 / -1; color: var(--text); font-family: var(--font-display); font-weight: 520; }
  .cv-job__summary { max-width: 66ch; color: var(--text-soft); }
  .cv-job__outcomes { display: grid; gap: var(--space-2); max-width: 66ch; padding-inline-start: 1.1rem; color: var(--text-soft); list-style-type: disc; }
  .cv-job__outcomes li::marker { color: var(--violet); }
  .cv-job__stack { color: var(--text-muted); font-family: var(--font-display); font-size: var(--step--1); font-weight: 500; }

  .cv-others { display: grid; gap: var(--space-3); max-width: 66ch; list-style: none; color: var(--text-soft); }
  .cv-others strong { color: var(--text); font-family: var(--font-display); font-weight: 600; }

  .cv-skills { display: grid; border-block-start: 1px solid var(--line); }
  .cv-skills > div { display: grid; grid-template-columns: minmax(9rem, 0.3fr) minmax(0, 1fr); gap: var(--space-2) var(--space-5); padding-block: var(--space-4); border-block-end: 1px solid var(--line); }
  .cv-skills dt { color: var(--text); font-family: var(--font-display); font-weight: 600; }
  .cv-skills dd { color: var(--text-soft); }

  .cv-education .cv-job__role { color: var(--text-soft); font-family: var(--font-body); font-weight: 400; }

  @media (max-width: 63.99em) {
    .cv-head { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .cv-sheet { grid-template-columns: minmax(0, 1fr); }
    .cv-side { border-inline-end: 0; border-block-end: 1px solid var(--line); }
    .cv-side__inner { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-6); }
    .cv-id { grid-column: 1 / -1; }
    .cv-side__block:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 47.99em) {
    .cv-head h1 { font-size: clamp(2.5rem, 1.2rem + 6.5vw, 3.5rem); }
    .cv-head .button-row .button { flex: 1 1 13rem; }
    .cv-side__inner { grid-template-columns: minmax(0, 1fr); }
    .cv-skills > div, .cv-job__head { grid-template-columns: minmax(0, 1fr); }
    .cv-job__period { grid-row: 1; text-align: start; }
  }

  /* Print: a plain black-on-white document; the site chrome and screen-only actions are removed. */
  @page { margin: 14mm 16mm; }

  @media print {
    :global(html:has([data-cv-page])),
    :global(body:has([data-cv-page])) { background: #fff; color: #111; }
    :global(body:has([data-cv-page]) .site-header),
    :global(body:has([data-cv-page]) .site-footer),
    :global(body:has([data-cv-page]) .skip-link) { display: none; }

    .cv {
      --text: #111;
      --text-soft: #2b2b2b;
      --text-muted: #555;
      --violet: #3d2a8c;
      --line: #d6d6d6;
      --line-strong: #bdbdbd;
      font-size: 10pt;
      line-height: 1.45;
    }
    .cv-head { display: none; }
    .cv-sheet { display: block; width: auto; margin: 0; border: 0; border-radius: 0; background: none; }

    .cv-side { padding: 0 0 5mm; border: 0; border-block-end: 0.75pt solid var(--line-strong); }
    .cv-side__inner { position: static; grid-template-columns: 1.3fr 1fr 1fr; gap: 3mm 8mm; }
    .cv-id { grid-column: 1 / -1; }
    .cv-id__name { font-size: 22pt; }
    .cv-id__role { font-size: 11pt; }
    .cv-id__place, .cv-side__list, .cv-side__text { font-size: 9pt; }
    .cv-side__block { gap: 1mm; padding: 0; border: 0; }
    .cv-side__block:last-child { grid-column: auto; }
    .cv-side__title { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.06em; }
    .cv-side__list { gap: 0.5mm; }
    .cv-side__list a { display: block; min-height: 0; text-decoration: none; }
    .cv-side__service { display: none; }

    .cv-main { display: block; padding: 0; }
    .cv-section { display: block; margin-block-start: 6mm; }
    .cv-section__title {
      margin-block-end: 2.5mm;
      font-size: 9pt;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      break-after: avoid;
    }
    .cv-summary { max-width: none; font-size: 10pt; }
    .cv-jobs { border: 0; }
    .cv-jobs > .cv-job { padding-block: 0 4mm; border: 0; }
    .cv-job { gap: 1.2mm; break-inside: avoid; }
    .cv-job__head { grid-template-columns: 1fr auto; }
    .cv-job__head h3 { font-size: 12pt; }
    .cv-job__period { grid-row: auto; font-size: 9pt; text-align: end; }
    .cv-job__role { font-size: 10pt; }
    .cv-job__summary, .cv-job__outcomes, .cv-others { max-width: none; }
    .cv-job__outcomes { gap: 0.8mm; }
    .cv-job__stack { font-size: 8.5pt; }
    .cv-skills { border: 0; }
    .cv-skills > div { grid-template-columns: 38mm 1fr; padding-block: 1.2mm; border: 0; break-inside: avoid; }
    .cv-others { gap: 1.5mm; }
  }
</style>
