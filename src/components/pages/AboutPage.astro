---
import Icon from '@/components/ui/Icon.astro';
import AboutIntro from '@/components/about/AboutIntro.astro';
import WorkPrinciples from '@/components/about/WorkPrinciples.astro';
import ExperienceEntry from '@/components/about/ExperienceEntry.astro';
import OtherWork from '@/components/about/OtherWork.astro';
import { copy, experience, withLocale, type Locale } from '@/data/content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = copy[locale];
const pt = locale === 'pt';
// Legacy case-study URLs redirect here, so the anchor names stay stable per locale.
const experienceId = pt ? 'experiencia' : 'experience';
const ui = pt
  ? {
      title: 'Do produto próprio a plataformas com milhares de usuários.',
      lede: 'Abra cada item para ver o contexto, o desafio e a solução.',
      cv: 'Ver currículo completo',
      ctaTitle: 'Agora veja o trabalho funcionando.',
      ctaText: 'Os projetos deste portfólio são demonstrações autorais que você pode abrir e usar no navegador. O currículo completo está em PDF.',
      cvShort: 'Ver currículo',
    }
  : {
      title: 'From an owned product to platforms with thousands of users.',
      lede: 'Open any entry for the context, the challenge, and the solution.',
      cv: 'View the full CV',
      ctaTitle: 'Now see the work running.',
      ctaText: 'The projects in this portfolio are demos I built that you can open and use in your browser. The full CV is available as a PDF.',
      cvShort: 'View CV',
    };
---

<AboutIntro locale={locale} experienceId={experienceId} />

<WorkPrinciples locale={locale} />

<section class="experience-detail" id={experienceId} aria-labelledby="experience-detail-title">
  <div class="shell">
    <header class="section-head" data-reveal>
      <div class="section-head__title">
        <p class="section-index">{t.experienceTitle}</p>
        <h2 id="experience-detail-title">{ui.title}</h2>
      </div>
      <div class="section-head__aside">
        <p class="lede">{ui.lede}</p>
        <a class="text-link" href={withLocale(locale, 'cv')}>{ui.cv}<Icon name="arrow-right" /></a>
      </div>
    </header>
    <ol class="experience-detail__list">
      {experience.map((item) => <li><ExperienceEntry item={item} locale={locale} /></li>)}
    </ol>
  </div>
  <OtherWork locale={locale} />
</section>

<aside class="cta-band shell" aria-labelledby="about-cta-title">
  <div>
    <h2 id="about-cta-title">{ui.ctaTitle}</h2>
    <p>{ui.ctaText}</p>
  </div>
  <div class="button-row">
    <a class="button button--primary" href={withLocale(locale, 'work')}>{t.seeWork}<Icon name="arrow-right" /></a>
    <a class="button button--secondary" href={withLocale(locale, 'cv')}>{ui.cvShort}</a>
  </div>
</aside>

<style>
  .experience-detail { padding-block-start: var(--section-space); border-block-start: 1px solid var(--line); background: linear-gradient(180deg, var(--surface-1), var(--canvas) 22rem); }
  .experience-detail__list { list-style: none; }
</style>
