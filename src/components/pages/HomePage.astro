---
import { cases, copy, identity, localize, services, withLocale, type Locale } from '@/data/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const featuredCases = ['edgedata', 'trinks', 'academic-operations'].map((slug) => cases.find((item) => item.slug === slug)!);
const featuredServices = ['b2b-saas-internal-systems', 'websites-landing-pages', 'frontend-modernization'].map((slug) => services.find((service) => service.slug === slug)!);
---

<section class="hero-stage" aria-labelledby="hero-title">
  <div class="hero-stage__atmosphere" aria-hidden="true">
    <span class="hero-stage__axis hero-stage__axis--x"></span>
    <span class="hero-stage__axis hero-stage__axis--y"></span>
    <span class="hero-stage__coordinate">40.6566° N / 7.9125° W</span>
  </div>
  <div class="hero shell">
    <div class="hero__copy">
      <p class="availability"><span aria-hidden="true"></span>{identity.availability[locale]}</p>
      <h1 id="hero-title">
        {locale === 'pt' ? <>Eu construo o software por trás de <span>operações complexas.</span></> : <>I build the software behind <span>complex operations.</span></>}
      </h1>
      <p class="hero__intro">{t.heroIntro}</p>
      <div class="button-row">
        <a class="button button--primary" href={withLocale(locale, 'contact')}>{t.discuss}<span aria-hidden="true">↗</span></a>
        <a class="button button--quiet" href="#selected-work">{t.seeWork}<span aria-hidden="true">↓</span></a>
      </div>
      <dl class="hero__facts" aria-label={locale === 'pt' ? 'Resumo profissional' : 'Professional summary'}>
        <div><dt>10+</dt><dd>{locale === 'pt' ? 'anos em software' : 'years in software'}</dd></div>
        <div><dt>6</dt><dd>{locale === 'pt' ? 'anos na Revvo' : 'years at Revvo'}</dd></div>
        <div><dt>200+</dt><dd>{locale === 'pt' ? 'melhorias em 6 meses' : 'improvements in 6 months'}</dd></div>
      </dl>
    </div>
    <figure class="hero-portrait" data-reveal>
      <div class="hero-portrait__frame">
        <div class="hero-portrait__image-stack">
          <img class="hero-portrait__image hero-portrait__image--base" src="/images/rafael-santanna.jpg" alt={locale === 'pt' ? 'Rafael Sant’ Anna, engenheiro de software sênior' : 'Rafael Sant’ Anna, senior software engineer'} width="400" height="400" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <div class="hero-portrait__grid" aria-hidden="true"></div>
        <div class="hero-portrait__scan" aria-hidden="true"></div>
      </div>
      <figcaption><span>RS / 01</span>{identity.location}</figcaption>
    </figure>
  </div>
</section>

<section class="engagement-paths shell" aria-labelledby="engagement-title" data-reveal>
  <div class="engagement-paths__heading">
    <p class="section-index">00 / {locale === 'pt' ? 'COMO POSSO AJUDAR' : 'HOW I CAN HELP'}</p>
    <h2 id="engagement-title">{locale === 'pt' ? 'Duas formas de trabalhar comigo.' : 'Two ways to work with me.'}</h2>
  </div>
  <div class="engagement-paths__grid">
    <article>
      <p class="eyebrow">{locale === 'pt' ? 'Contrato PJ / reforço de equipe' : 'Remote contract / team reinforcement'}</p>
      <h3>{locale === 'pt' ? 'Senioridade para entrar e entregar.' : 'Senior delivery that joins the work quickly.'}</h3>
      <p>{locale === 'pt' ? 'Disponibilidade imediata, ME ativa e cobertura integral do horário comercial brasileiro.' : 'Available immediately through an active Brazilian company, with full overlap with Brazilian business hours.'}</p>
      <div class="button-row"><a class="text-link" href={withLocale(locale, 'cv')}>{locale === 'pt' ? 'Ver currículo' : 'View CV'}<span>→</span></a><a class="text-link" href={withLocale(locale, 'contact')}>{locale === 'pt' ? 'Entrar em contato' : 'Get in touch'}<span>→</span></a></div>
    </article>
    <article>
      <p class="eyebrow">{locale === 'pt' ? 'Projeto fechado / site / sistema' : 'Fixed project / website / system'}</p>
      <h3>{locale === 'pt' ? 'Escopo claro, execução focada.' : 'Clear scope, focused execution.'}</h3>
      <p>{locale === 'pt' ? 'Sites, landing pages, sistemas internos e modernização de produtos existentes.' : 'Websites, landing pages, internal systems, and modernization of existing products.'}</p>
      <div class="button-row"><a class="text-link" href={withLocale(locale, 'services')}>{locale === 'pt' ? 'Ver serviços' : 'View services'}<span>→</span></a><a class="text-link" href={`${withLocale(locale, 'work')}#concepts`}>{locale === 'pt' ? 'Ver conceitos' : 'View concepts'}<span>→</span></a></div>
    </article>
  </div>
</section>

<section id="selected-work" class="section section--work">
  <div class="shell section-heading" data-reveal>
    <p class="section-index">01 / {locale === 'pt' ? 'PROJETOS' : 'WORK'}</p>
    <div><h2>{t.proofTitle}</h2><p>{t.proofIntro}</p></div>
  </div>
  <div class="work-ledger">
    {featuredCases.map((item, index) => (
      <article class:list={['work-row', index % 2 ? 'work-row--reverse' : '']} data-reveal>
        <div class="work-row__visual">
          <img src={item.image} alt={localize(item.imageAlt, locale)} width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" />
          <span class="work-row__coordinate">{String(index + 1).padStart(2, '0')} / 03</span>
        </div>
        <div class="work-row__copy">
          <p class="eyebrow">{localize(item.eyebrow, locale)}</p>
          <h3><a href={withLocale(locale, `work/${item.slug}`)}>{item.title}</a></h3>
          <p>{localize(item.summary, locale)}</p>
          <ul class="tag-list" aria-label={t.technologies}>
            {item.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}
          </ul>
          <span class="text-link" aria-hidden="true">{t.viewCase}<span>→</span></span>
        </div>
      </article>
    ))}
  </div>
  <div class="shell section-end"><a class="button button--outline" href={withLocale(locale, 'work')}>{t.nav.work}<span aria-hidden="true">→</span></a></div>
</section>

<section class="section services-field">
  <div class="shell section-heading section-heading--dark" data-reveal>
    <p class="section-index">02 / {locale === 'pt' ? 'SERVIÇOS' : 'SERVICES'}</p>
    <div><h2>{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div>
  </div>
  <div class="shell service-lines">
    {featuredServices.map((service) => (
      <a class="service-line" href={withLocale(locale, `services/${service.slug}`)} data-reveal>
        <span class="service-line__index">{service.index}</span>
        <span class="service-line__main"><strong>{localize(service.title, locale)}</strong><small>{localize(service.summary, locale)}</small></span>
        <span class="service-line__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
  <div class="shell section-end"><a class="button button--outline button--outline-dark" href={withLocale(locale, 'services')}>{t.nav.services}<span aria-hidden="true">→</span></a></div>
</section>

<section class="cta-field shell" data-reveal>
  <p class="section-index">03 / {locale === 'pt' ? 'CONTATO' : 'CONTACT'}</p>
  <div>
    <h2>{locale === 'pt' ? 'Qual operação precisa ficar mais clara?' : 'Which operation needs to become clearer?'}</h2>
    <p>{locale === 'pt' ? 'Descreva o sistema, a restrição ou o fluxo que você precisa melhorar.' : 'Describe the system, constraint, or workflow you need to improve.'}</p>
  </div>
  <a class="button button--signal" href={withLocale(locale, 'contact')}>{t.discuss}<span aria-hidden="true">↗</span></a>
</section>
