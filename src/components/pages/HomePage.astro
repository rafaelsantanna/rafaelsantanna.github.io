---
import DeskHero from '@/components/home/DeskHero.astro';
import CapabilityStrip from '@/components/home/CapabilityStrip.astro';
import Showroom from '@/components/home/Showroom.astro';
import ExperienceBand from '@/components/home/ExperienceBand.astro';
import ContactClose from '@/components/home/ContactClose.astro';
import HomeFaq from '@/components/home/HomeFaq.astro';
import ServiceList from '@/components/ui/ServiceList.astro';
import Icon from '@/components/ui/Icon.astro';
import { copy, withLocale, type Locale } from '@/data/content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = copy[locale];
const pt = locale === 'pt';
const ids = pt ? { projects: 'projetos', contact: 'contato' } : { projects: 'projects', contact: 'contact' };
---

<DeskHero locale={locale} projectsId={ids.projects} contactId={ids.contact} />
<CapabilityStrip locale={locale} />
<Showroom locale={locale} id={ids.projects} />

<section class="home-services section" aria-labelledby="home-services-title">
  <div class="shell">
    <header class="section-head" data-reveal>
      <div class="section-head__title">
        <p class="section-index">{t.nav.services}</p>
        <h2 id="home-services-title">{t.servicesTitle}</h2>
      </div>
      <div class="section-head__aside">
        <p class="lede">{t.servicesIntro}</p>
        <a class="text-link" href={withLocale(locale, 'services')}>{pt ? 'Todos os serviços' : 'All services'}<Icon name="arrow-right" /></a>
      </div>
    </header>
    <ServiceList locale={locale} preview />
  </div>
</section>

<ExperienceBand locale={locale} />
<HomeFaq locale={locale} />
<ContactClose locale={locale} id={ids.contact} />
