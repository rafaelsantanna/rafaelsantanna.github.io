---
import { cases, copy, identity, localize, services, withLocale, type Locale } from '@/data/content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = copy[locale];
const featuredCases = ['edgedata', 'trinks', 'academic-operations'].map((slug) => cases.find((item) => item.slug === slug)!);
const workingStages = [
  {
    title: { pt: 'Entender o que a operação precisa fazer.', en: 'Understand what the operation needs to do.' },
    description: { pt: 'Mapear papéis, regras, prazos e exceções antes de definir telas e dados. Em operações empresariais, isso orienta formulários dinâmicos e fluxos de aprovação.', en: 'Map roles, rules, deadlines, and exceptions before defining screens and data. In enterprise operations, this shapes dynamic forms and approval workflows.' },
    caseSlug: 'enterprise-operations',
  },
  {
    title: { pt: 'Levar tarefas frequentes para fluxos claros.', en: 'Turn frequent tasks into clear workflows.' },
    description: { pt: 'Organizar interfaces administrativas e agendamentos para que atividades do dia a dia funcionem em diferentes dispositivos e canais.', en: 'Organize administrative interfaces and bookings so everyday tasks work across devices and channels.' },
    caseSlug: 'trinks',
  },
  {
    title: { pt: 'Integrar ao ecossistema que já existe.', en: 'Connect to the ecosystem already in place.' },
    description: { pt: 'Considerar dados e sistemas empresariais desde o desenho do produto. Em plataformas de aprendizagem, isso inclui integrações com ERP, CRM, BI e ferramentas de RH.', en: 'Account for enterprise data and systems from the start. For learning platforms, that includes integrations with ERP, CRM, BI, and HR tools.' },
    caseSlug: 'corporate-learning',
  },
].map((stage) => ({ ...stage, case: cases.find((item) => item.slug === stage.caseSlug)! }));
const decisionPaths = [
  {
    verb: { pt: 'CONSTRUIR', en: 'BUILD' },
    title: { pt: 'Um produto novo para uma operação complexa.', en: 'A new product for a complex operation.' },
    description: { pt: 'Transformar regras, permissões e dados operacionais em um sistema que a equipe possa usar todos os dias.', en: 'Turn rules, permissions, and operational data into a system a team can use every day.' },
    serviceSlug: 'b2b-saas-internal-systems',
    evidenceSlug: 'edgedata',
  },
  {
    verb: { pt: 'EVOLUIR', en: 'EVOLVE' },
    title: { pt: 'Uma plataforma que precisa acompanhar o negócio.', en: 'A platform that needs to keep up with the business.' },
    description: { pt: 'Modernizar interfaces e fluxos aos poucos, preservando as regras que mantêm a operação funcionando.', en: 'Modernize interfaces and workflows incrementally while preserving the rules that keep operations running.' },
    serviceSlug: 'frontend-modernization',
    evidenceSlug: 'academic-operations',
  },
  {
    verb: { pt: 'CONECTAR', en: 'CONNECT' },
    title: { pt: 'Sistemas e equipes trabalhando juntos.', en: 'Systems and teams working together.' },
    description: { pt: 'Conectar plataformas, dados e processos empresariais com integrações que cabem no fluxo de trabalho.', en: 'Connect platforms, data, and business processes through integrations that fit the way people work.' },
    serviceSlug: 'b2b-saas-internal-systems',
    evidenceSlug: 'corporate-learning',
  },
].map((path) => ({
  ...path,
  service: services.find((service) => service.slug === path.serviceSlug)!,
  evidence: cases.find((item) => item.slug === path.evidenceSlug)!,
}));
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__inner">
    <div class="home-hero__visual">
      <img src="/images/hero-concept-02.png" alt={locale === 'pt' ? 'Retrato em preto e branco de Rafael Sant’ Anna, com fones e uma composição de pontos lilás' : 'Black-and-white portrait of Rafael Sant’ Anna with headphones and a lavender dot composition'} width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="home-hero__copy">
      <p class="home-hero__role">{identity.name}</p>
      <h1 id="home-title">{locale === 'pt' ? 'Software para operações reais.' : 'Software for real operations.'}</h1>
      <p class="home-hero__statement">{locale === 'pt' ? 'Engenharia de produto, frontend e sistemas internos.' : 'Product engineering, frontend, and internal systems.'}</p>
      <div class="home-hero__actions">
        <a class="button button--signal" href="#selected-work">{locale === 'pt' ? 'Explorar projetos' : 'Explore projects'}<span aria-hidden="true">→</span></a>
        <a class="home-hero__contact-link" href={withLocale(locale, 'contact')}>{t.nav.contact}</a>
      </div>
      <nav class="home-hero__case-links" aria-label={locale === 'pt' ? 'Projetos em destaque' : 'Featured projects'}>
        <p>{locale === 'pt' ? 'Projetos em destaque' : 'Featured projects'}</p>
        <div>
        {featuredCases.map((item, index) => (
          <a href={withLocale(locale, `work/${item.slug}`)}>
            <span class="home-hero__case-index">0{index + 1}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
        </div>
      </nav>
    </div>
  </div>
</section>

<section id="selected-work" class="home-work shell" aria-labelledby="home-work-title">
  <header class="home-section-heading" data-reveal>
    <p class="eyebrow">{locale === 'pt' ? 'Trabalho selecionado' : 'Selected work'}</p>
    <div><h2 id="home-work-title">{locale === 'pt' ? 'Sistemas reais, feitos para o trabalho real.' : 'Real systems, built for real work.'}</h2><p>{locale === 'pt' ? 'Produtos e plataformas em que regras, integrações e confiabilidade fazem diferença todos os dias.' : 'Products and platforms where rules, integrations, and reliability matter every day.'}</p></div>
  </header>
  <div class="home-case-grid">
    {featuredCases.map((item, index) => (
      <article class:list={['home-case', index === 0 && 'home-case--featured']} data-reveal>
        <a class="home-case__link" href={withLocale(locale, `work/${item.slug}`)} aria-label={`${item.title}: ${t.viewCase}`}>
          <div class="home-case__image">
            <img src={item.image} alt={localize(item.imageAlt, locale)} width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" />
            <span class="home-case__arrow" aria-hidden="true">↗</span>
          </div>
          <div class="home-case__caption">
            <div><p class="eyebrow">{localize(item.eyebrow, locale)}</p><h3>{item.title}</h3></div>
            <p>{localize(item.summary, locale)}</p>
          </div>
        </a>
      </article>
    ))}
  </div>
  <div class="home-work__more"><a class="text-link" href={withLocale(locale, 'work')}>{locale === 'pt' ? 'Ver todos os projetos' : 'See all projects'}<span aria-hidden="true">↗</span></a></div>
</section>

<section class="home-decision shell" aria-labelledby="home-decision-title">
  <header class="home-section-heading" data-reveal>
    <p class="eyebrow">{locale === 'pt' ? 'Por onde começar' : 'Find a starting point'}</p>
    <div><h2 id="home-decision-title">{locale === 'pt' ? 'O que precisa mudar?' : 'What needs to change?'}</h2><p>{locale === 'pt' ? 'Escolha o desafio mais próximo do seu. Cada caminho leva a um serviço e a um exemplo real.' : 'Choose the challenge closest to yours. Each path leads to a service and a real example.'}</p></div>
  </header>
  <div class="home-decision__choices">
    {decisionPaths.map((path, index) => (
      <details class="home-decision__option" name="home-decision-path" open={index === 0} data-reveal>
        <summary>
          <span class="home-decision__index">{String(index + 1).padStart(2, '0')} <span aria-hidden="true">/</span></span>
          <span class="home-decision__verb">{localize(path.verb, locale)}</span>
          <span class="home-decision__toggle" aria-hidden="true"></span>
        </summary>
        <div class="home-decision__panel">
          <div class="home-decision__copy">
            <p class="eyebrow">{localize(path.service.title, locale)}</p>
            <h3>{localize(path.title, locale)}</h3>
            <p>{localize(path.description, locale)}</p>
            <a class="text-link" href={withLocale(locale, `services/${path.service.slug}`)}>{locale === 'pt' ? 'Ver serviço' : 'Explore the service'}<span aria-hidden="true">↗</span></a>
          </div>
          <a class="home-decision__evidence" href={withLocale(locale, `work/${path.evidence.slug}`)} aria-label={`${path.evidence.title}: ${t.viewCase}`}>
            <img src={path.evidence.image} alt={localize(path.evidence.imageAlt, locale)} width={path.evidence.imageWidth} height={path.evidence.imageHeight} loading="lazy" decoding="async" />
            <span>{locale === 'pt' ? 'Caso relacionado' : 'Related case'}<strong>{path.evidence.title}</strong><b aria-hidden="true">↗</b></span>
          </a>
        </div>
      </details>
    ))}
  </div>
</section>

<section class="home-note" aria-labelledby="home-note-title" data-reveal>
  <div class="home-note__inner shell">
    <p class="home-note__mark" aria-hidden="true">RS</p>
    <div class="home-note__copy">
      <p class="eyebrow">{locale === 'pt' ? 'Como penso' : 'How I think'}</p>
      <h2 id="home-note-title">{locale === 'pt' ? 'A melhor solução começa entendendo o trabalho.' : 'The best solution starts with understanding the work.'}</h2>
      <p>{locale === 'pt' ? 'Há mais de uma década construo software. Foram seis anos na Revvo, trabalhando perto de produto, operação e equipes que dependem de sistemas confiáveis.' : 'I’ve spent more than a decade building software, including six years at Revvo, working close to product, operations, and teams that depend on reliable systems.'}</p>
      <a class="text-link" href={withLocale(locale, 'about')}>{locale === 'pt' ? 'Conheça minha trajetória' : 'More about my approach'}<span aria-hidden="true">↗</span></a>
    </div>
    <p class="home-note__years"><strong>10+</strong><span>{locale === 'pt' ? 'anos construindo software' : 'years building software'}</span><strong>6</strong><span>{locale === 'pt' ? 'anos na Revvo' : 'years at Revvo'}</span></p>
  </div>
</section>

<section class="home-approach shell" aria-labelledby="home-approach-title">
  <header class="home-section-heading" data-reveal>
    <p class="eyebrow">{locale === 'pt' ? 'Como trabalho' : 'How I work'}</p>
    <div><h2 id="home-approach-title">{locale === 'pt' ? 'Decisões técnicas começam no trabalho real.' : 'Technical decisions start with the work itself.'}</h2><p>{locale === 'pt' ? 'Três pontos de atenção que aparecem em projetos de operação, produto e integração.' : 'Three considerations that recur across operations, product, and integration work.'}</p></div>
  </header>
  <ol class="home-approach__list">
    {workingStages.map((stage, index) => (
      <li class="home-approach__item" data-reveal>
        <span class="home-approach__index">0{index + 1}</span>
        <div>
          <h3>{localize(stage.title, locale)}</h3>
          <p>{localize(stage.description, locale)}</p>
          <a class="text-link" href={withLocale(locale, `work/${stage.case.slug}`)}>{locale === 'pt' ? `Ver caso: ${stage.case.title}` : `See case: ${stage.case.title}`}<span aria-hidden="true">↗</span></a>
        </div>
      </li>
    ))}
  </ol>
  <a class="home-services__all" href={withLocale(locale, 'services')}>{locale === 'pt' ? 'Ver todos os serviços' : 'Explore all services'}<span aria-hidden="true">↗</span></a>
</section>

<section class="home-engagement shell" aria-labelledby="home-engagement-title" data-reveal>
  <header><p class="eyebrow">{locale === 'pt' ? 'Duas formas de trabalhar' : 'Two ways to work together'}</p><h2 id="home-engagement-title">{locale === 'pt' ? 'O formato que combina com o desafio.' : 'A format that fits the challenge.'}</h2></header>
  <div class="home-engagement__options">
    <article>
      <p class="home-engagement__kicker">{locale === 'pt' ? 'Equipe' : 'Team'}</p>
      <h3>{locale === 'pt' ? 'Senioridade para somar ao time.' : 'Senior experience for your team.'}</h3>
      <p>{locale === 'pt' ? 'Disponibilidade imediata para contratos PJ remotos, com cobertura integral do horário comercial brasileiro.' : 'Available immediately for remote PJ contracts, with full overlap with Brazilian business hours.'}</p>
      <a class="text-link" href={withLocale(locale, 'cv')}>{locale === 'pt' ? 'Ver currículo' : 'View CV'}<span aria-hidden="true">↗</span></a>
    </article>
    <article>
      <p class="home-engagement__kicker">{locale === 'pt' ? 'Projeto' : 'Project'}</p>
      <h3>{locale === 'pt' ? 'Escopo claro, execução focada.' : 'Clear scope, focused delivery.'}</h3>
      <p>{locale === 'pt' ? 'Sites, sistemas internos e modernização de produtos existentes, do diagnóstico à entrega.' : 'Websites, internal systems, and product modernization, from discovery through delivery.'}</p>
      <a class="text-link" href={withLocale(locale, 'services')}>{locale === 'pt' ? 'Explorar serviços' : 'Explore services'}<span aria-hidden="true">↗</span></a>
    </article>
  </div>
</section>

<style>
  .home-approach { padding-block: clamp(5rem, 8vw, 7.5rem); }
  .home-approach .home-section-heading { margin-block-end: clamp(2rem, 4vw, 3.5rem); }
  .home-approach__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); margin: 0; padding: 0; list-style: none; }
  .home-approach__item { display: grid; grid-template-rows: auto 1fr; gap: 1.4rem; min-width: 0; padding-block: 1.25rem 0; border-block-start: 2px solid var(--cobalt); }
  .home-approach__index { color: var(--cobalt); font-family: var(--font-display); font-size: 0.82rem; font-weight: 700; }
  .home-approach__item > div { display: grid; align-content: start; gap: 0.9rem; }
  .home-approach__item h3 { max-width: 18ch; font-size: clamp(1.35rem, 2vw, 1.8rem); letter-spacing: -0.04em; }
  .home-approach__item p { color: var(--ink-soft); font-size: 0.94rem; }
  .home-approach__item .text-link { align-self: end; justify-self: start; margin-block-start: 0.25rem; }
  @media (max-width: 54rem) { .home-approach__list { grid-template-columns: 1fr; gap: 1.75rem; } }
</style>

<section class="home-contact" aria-labelledby="home-contact-title" data-reveal>
  <div class="home-contact__inner shell">
    <p class="eyebrow">{locale === 'pt' ? 'Vamos conversar' : 'Start a conversation'}</p>
    <h2 id="home-contact-title">{locale === 'pt' ? 'Qual parte do seu trabalho merece ficar mais simples?' : 'What part of your work deserves to feel simpler?'}</h2>
    <div class="home-contact__bottom">
      <p>{locale === 'pt' ? 'Conte o que está difícil, lento ou pronto para evoluir.' : 'Tell me what feels difficult, slow, or ready to move forward.'}</p>
      <a class="button button--signal" href={withLocale(locale, 'contact')}>{t.discuss}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
