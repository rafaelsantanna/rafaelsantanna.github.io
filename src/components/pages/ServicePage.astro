---
import { cases, concepts, copy, localize, withLocale, type Locale, type Service } from '@/data/content';
import '@/styles/demos.css';
interface Props { locale: Locale; service: Service }
const { locale, service } = Astro.props;
const t = copy[locale];
const evidence = service.evidence.map((slug) => cases.find((item) => item.slug === slug)).filter(Boolean);
---

<article class="detail-page service-detail">
  <header class="detail-hero detail-hero--service shell">
    <a class="back-link" href={withLocale(locale, 'services')}><span aria-hidden="true">←</span>{t.backServices}</a>
    <div class="detail-hero__heading">
      <div><p class="eyebrow">{t.nav.services}</p><h1>{localize(service.title, locale)}</h1></div>
    </div>
    <p class="detail-hero__summary">{localize(service.summary, locale)}</p>
    <div class="service-hero__routes">
      <section>
        <h2>{t.fit}</h2>
        <ul>{service.idealFor[locale].map((item) => <li>{item}</li>)}</ul>
      </section>
      <section>
        <h2>{t.deliverables}</h2>
        <ul>{service.deliverables[locale].map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
  </header>

  <section class="evidence-list shell">
    <div class="section-heading section-heading--compact" data-reveal><h2>{service.slug === 'websites-landing-pages' ? (locale === 'pt' ? 'Trabalho entregue' : 'Delivered work') : t.evidence}</h2></div>
    {evidence.map((item) => item && (
      <a class="evidence-row" href={withLocale(locale, `work/${item.slug}`)} data-reveal>
        <span>{item.title}</span><small>{localize(item.summary, locale)}</small><b aria-hidden="true">↗</b>
      </a>
    ))}
  </section>

  {service.slug === 'websites-landing-pages' && <section class="service-demos shell" aria-labelledby="service-demos-title">
    <div class="section-heading section-heading--compact" data-reveal>
      <p class="section-index">{locale === 'pt' ? 'Demonstrações autorais' : 'Authorial demonstrations'}</p>
      <div><h2 id="service-demos-title">{locale === 'pt' ? 'Explore duas jornadas de página' : 'Explore two page journeys'}</h2><p>{locale === 'pt' ? 'Estas demos mostram possibilidades de estrutura e interação para segmentos diferentes. São projetos ilustrativos, separados do trabalho entregue acima.' : 'These demos show possible structures and interactions for two industries. They are illustrative projects, separate from the delivered work above.'}</p></div>
    </div>
    <div class="service-demos__links">{concepts.map((concept) => <a href={withLocale(locale, `work/landing-pages/${concept.slug}`)}><span><small>{localize(concept.disclaimer, locale)}</small><strong>{localize(concept.demoName, locale)}</strong><em>{localize(concept.demoTagline, locale)}</em></span><b aria-hidden="true">↗</b></a>)}</div>
  </section>}

  <section class="detail-tech shell" data-reveal>
    <h2>{t.technologies}</h2>
    <ul class="tag-list">{service.technologies.map((technology) => <li>{technology}</li>)}</ul>
  </section>

  <div class="detail-actions shell"><a class="button button--signal" href={withLocale(locale, 'contact')}>{t.discuss}<span aria-hidden="true">↗</span></a></div>
</article>
