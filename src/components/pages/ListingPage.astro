---
import { cases, concepts, copy, localize, selectedWork, services, withLocale, type Locale } from '@/data/content';
interface Props { locale: Locale; type: 'work' | 'services' }
const { locale, type } = Astro.props;
const t = copy[locale];
---

<section class:list={['page-hero', `page-hero--${type}`, 'shell']}>
  <div class="listing-hero__copy">
    <p class="section-index">{type === 'work' ? (locale === 'pt' ? 'Projetos' : 'Selected work') : (locale === 'pt' ? 'Serviços' : 'Services')}</p>
    <h1>{type === 'work' ? t.workTitle : (locale === 'pt' ? 'Da ideia ao software.' : 'From idea to software.')}</h1>
    <p>{type === 'work' ? t.workIntro : t.servicesPageIntro}</p>
  </div>
  {type === 'work' ? (
    <figure class="listing-hero__preview">
      <img src={cases[0].image} alt={localize(cases[0].imageAlt, locale)} width={cases[0].imageWidth} height={cases[0].imageHeight} />
      <figcaption>{locale === 'pt' ? 'Projeto em destaque: EdgeData' : 'Featured project: EdgeData'}</figcaption>
    </figure>
  ) : (
    <ul class="listing-hero__principles" aria-label={locale === 'pt' ? 'Princípios de entrega' : 'Delivery principles'}>
      <li>{locale === 'pt' ? 'Problema real' : 'Real problem'}</li>
      <li>{locale === 'pt' ? 'Entrega focada' : 'Focused delivery'}</li>
      <li>{locale === 'pt' ? 'Evidência relacionada' : 'Related evidence'}</li>
    </ul>
  )}
</section>

{type === 'work' ? (
  <>
    <section class="case-index shell" aria-label={t.workTitle}>
      {cases.map((item) => (
        <article class="case-index__item" data-reveal>
          <div class="case-index__image"><img src={item.image} alt={localize(item.imageAlt, locale)} width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" /></div>
          <div class="case-index__copy">
            <p class="eyebrow">{localize(item.eyebrow, locale)}</p>
            <h2><a href={withLocale(locale, `work/${item.slug}`)}>{item.title}</a></h2>
            <p>{localize(item.summary, locale)}</p>
            <span class="text-link" aria-hidden="true">{t.viewCase}<span>→</span></span>
          </div>
        </article>
      ))}
    </section>
    <section id="landing-pages" class="concept-index shell" aria-labelledby="landing-pages-title">
      <div class="section-heading section-heading--compact" data-reveal>
        <p class="section-index">{locale === 'pt' ? 'Demonstrações' : 'Demonstrations'}</p>
        <div><h2 id="landing-pages-title">{locale === 'pt' ? 'Demonstrações navegáveis' : 'Navigable landing-page demos'}</h2><p>{locale === 'pt' ? 'Duas experiências completas para explorar jornadas comerciais de hospedagem e serviço local. As imagens são referências visuais, não capturas das interfaces.' : 'Two complete experiences showing commercial journeys for hospitality and local services. Images are visual references, not screenshots of the interfaces.'}</p></div>
      </div>
      <div class="case-index">
        {concepts.map((concept) => (
          <article class="case-index__item" data-reveal>
            <div class="case-index__image"><img src={concept.image.replace(/\.png$/, '.webp')} alt={localize(concept.imageAlt, locale)} width={concept.imageWidth} height={concept.imageHeight} loading="lazy" decoding="async" /></div>
            <div class="case-index__copy">
              <p class="eyebrow">{localize(concept.category, locale)}</p>
              <h3><a href={withLocale(locale, `work/landing-pages/${concept.slug}`)}>{localize(concept.demoName, locale)}</a></h3>
              <p>{localize(concept.demoTagline, locale)} {locale === 'pt' ? 'Uma página completa com navegação e uma jornada de planejamento local.' : 'A complete page with navigation and a local planning journey.'}</p>
              <p class="small-meta">{localize(concept.disclaimer, locale)}</p>
              <span class="text-link">{locale === 'pt' ? 'Explorar demonstração' : 'Explore the demo'}<span aria-hidden="true">→</span></span>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="selected-notes shell">
      <div class="section-heading section-heading--compact" data-reveal>
        <p class="section-index">{locale === 'pt' ? 'Experiência adicional' : 'Additional experience'}</p>
        <h2>{locale === 'pt' ? 'Experiência profissional' : 'Professional experience'}</h2>
      </div>
      <p>{locale === 'pt' ? 'Estas experiências aparecem aqui de forma resumida. Veja a trajetória e as competências no currículo.' : 'These experiences are summarized here. Explore my career and skills in the CV.'} <a href={withLocale(locale, 'cv')}>{locale === 'pt' ? 'Consultar currículo' : 'View CV'} ↗</a></p>
      <div class="selected-notes__list">
        {selectedWork.map((item) => (
          <article data-reveal>
            <h3>{item.title}</h3>
            <p>{localize(item.description, locale)}</p>
            <p class="small-meta">{item.technologies.join(' · ')}</p>
          </article>
        ))}
      </div>
    </section>
  </>
) : (
  <section class="service-index shell" aria-label={t.nav.services}>
    {services.map((service) => (
      <article class="service-index__item" data-reveal>
        <div>
          <h2><a href={withLocale(locale, `services/${service.slug}`)}>{localize(service.title, locale)}</a></h2>
          <p>{localize(service.summary, locale)}</p>
          <ul class="tag-list">{service.technologies.map((technology) => <li>{technology}</li>)}</ul>
        </div>
        <span class="service-index__link" aria-hidden="true">↗</span>
      </article>
    ))}
  </section>
)}

<section class="cta-field shell" data-reveal>
  <div>
    <h2>{locale === 'pt' ? 'Qual operação precisa ficar mais clara?' : 'Which operation needs to become clearer?'}</h2>
    <p>{locale === 'pt' ? 'Descreva o sistema, a restrição ou o fluxo que você precisa melhorar.' : 'Describe the system, constraint, or workflow you need to improve.'}</p>
  </div>
  <a class="button button--signal" href={withLocale(locale, 'contact')}>{t.discuss}<span aria-hidden="true">↗</span></a>
</section>
