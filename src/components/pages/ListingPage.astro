---
import { cases, concepts, copy, localize, selectedWork, services, withLocale, type Locale } from '@/data/content';
interface Props { locale: Locale; type: 'work' | 'services' }
const { locale, type } = Astro.props;
const t = copy[locale];
---

<section class:list={['page-hero', `page-hero--${type}`, 'shell']} data-code={type === 'work' ? (locale === 'pt' ? 'ÍNDICE / 01' : 'INDEX / 01') : (locale === 'pt' ? 'ÍNDICE / 02' : 'INDEX / 02')}>
  <div class="listing-hero__copy">
    <p class="section-index">{type === 'work' ? `01 / ${locale === 'pt' ? 'PROJETOS' : 'WORK'}` : `02 / ${locale === 'pt' ? 'SERVIÇOS' : 'SERVICES'}`}</p>
    <h1>{type === 'work' ? t.workTitle : t.servicesPageTitle}</h1>
    <p>{type === 'work' ? t.workIntro : t.servicesPageIntro}</p>
  </div>
  {type === 'work' ? (
    <figure class="listing-hero__preview">
      <img src={cases[0].image} alt={localize(cases[0].imageAlt, locale)} width={cases[0].imageWidth} height={cases[0].imageHeight} />
      <figcaption>{locale === 'pt' ? 'PROVA EM DESTAQUE / EDGEDATA' : 'FEATURED EVIDENCE / EDGEDATA'}</figcaption>
    </figure>
  ) : (
    <ul class="listing-hero__principles" aria-label={locale === 'pt' ? 'Princípios de entrega' : 'Delivery principles'}>
      <li><span>01</span>{locale === 'pt' ? 'Problema real' : 'Real problem'}</li>
      <li><span>02</span>{locale === 'pt' ? 'Entrega focada' : 'Focused delivery'}</li>
      <li><span>03</span>{locale === 'pt' ? 'Evidência relacionada' : 'Related evidence'}</li>
    </ul>
  )}
</section>

{type === 'work' ? (
  <>
    <section class="case-index shell" aria-label={t.workTitle}>
      {cases.map((item, index) => (
        <article class="case-index__item" data-reveal>
          <div class="case-index__number">{String(index + 1).padStart(2, '0')}</div>
          <div class="case-index__image"><img src={item.image} alt={localize(item.imageAlt, locale)} width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" /></div>
          <div class="case-index__copy">
            <p class="eyebrow">{localize(item.eyebrow, locale)}</p>
            <h2><a href={withLocale(locale, `work/${item.slug}`)}>{item.title}</a></h2>
            <p>{localize(item.summary, locale)}</p>
            <span class="text-link" aria-hidden="true">{t.viewCase}<span>→</span></span>
          </div>
        </article>
      ))}
    </section>
    <section id="concepts" class="concept-index shell" aria-labelledby="concepts-title">
      <div class="section-heading section-heading--compact" data-reveal>
        <p class="section-index">+ / {locale === 'pt' ? 'CONCEITOS' : 'CONCEPTS'}</p>
        <div><h2 id="concepts-title">{locale === 'pt' ? 'Projetos conceituais' : 'Concept projects'}</h2><p>{locale === 'pt' ? 'Demonstrações de abordagem visual e comercial. Marcas fictícias, sempre separadas dos trabalhos entregues.' : 'Demonstrations of visual and commercial approach. Fictional brands, always separated from delivered work.'}</p></div>
      </div>
      <div class="concept-index__grid">
        {concepts.map((concept) => (
          <article class={`concept-card concept-card--${concept.theme}`} data-reveal>
            <div class="concept-card__image"><img src={concept.image} alt={localize(concept.imageAlt, locale)} width={concept.imageWidth} height={concept.imageHeight} loading="lazy" decoding="async" /></div>
            <div class="concept-card__copy">
              <p class="concept-disclaimer">{localize(concept.disclaimer, locale)}</p>
              <p class="eyebrow">{localize(concept.category, locale)}</p>
              <h3><a href={withLocale(locale, `work/concepts/${concept.slug}`)}>{localize(concept.title, locale)}</a></h3>
              <p>{localize(concept.summary, locale)}</p>
              <span class="text-link" aria-hidden="true">{locale === 'pt' ? 'Explorar conceito' : 'Explore concept'}<span>→</span></span>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="selected-notes shell">
      <div class="section-heading section-heading--compact" data-reveal>
        <p class="section-index">+ / {locale === 'pt' ? 'OUTROS' : 'MORE'}</p>
        <h2>{locale === 'pt' ? 'Outros projetos selecionados' : 'Additional selected projects'}</h2>
      </div>
      <div class="selected-notes__list">
        {selectedWork.map((item) => (
          <article data-reveal>
            <h3>{item.title}</h3>
            <p>{localize(item.description, locale)}</p>
            <p class="small-meta">{item.technologies.join(' · ')}</p>
          </article>
        ))}
      </div>
    </section>
  </>
) : (
  <section class="service-index shell" aria-label={t.nav.services}>
    {services.map((service) => (
      <article class="service-index__item" data-reveal>
        <span class="service-index__number">{service.index}</span>
        <div>
          <h2><a href={withLocale(locale, `services/${service.slug}`)}>{localize(service.title, locale)}</a></h2>
          <p>{localize(service.summary, locale)}</p>
          <ul class="tag-list">{service.technologies.map((technology) => <li>{technology}</li>)}</ul>
        </div>
        <span class="service-index__link" aria-hidden="true">↗</span>
      </article>
    ))}
  </section>
)}
