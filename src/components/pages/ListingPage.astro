---
import Icon from '@/components/ui/Icon.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import ServiceList from '@/components/ui/ServiceList.astro';
import { copy, projects, withLocale, type Locale, type ProjectKind } from '@/data/content';

interface Props { locale: Locale; type: 'work' | 'services' }

const { locale, type } = Astro.props;
const t = copy[locale];
const pt = locale === 'pt';

const kinds: Array<{ value: 'all' | ProjectKind; label: string }> = pt
  ? [{ value: 'all', label: 'Todos' }, { value: 'product', label: 'Sistemas' }, { value: 'ai', label: 'IA' }, { value: 'site', label: 'Sites' }, { value: 'mobile', label: 'Mobile' }]
  : [{ value: 'all', label: 'All' }, { value: 'product', label: 'Systems' }, { value: 'ai', label: 'AI' }, { value: 'site', label: 'Websites' }, { value: 'mobile', label: 'Mobile' }];
const countFor = (kind: string) => (kind === 'all' ? projects.length : projects.filter((item) => item.kind === kind).length);
const ui = pt
  ? {
      workIndex: 'Projetos',
      servicesIndex: 'Serviços',
      note: 'Todos são projetos autorais, criados por mim para mostrar como eu trabalho.',
      noteMore: 'Trabalhos de clientes não são exibidos; a experiência real está no currículo.',
      filterLabel: 'Filtrar por tipo',
      one: '{n} projeto',
      other: '{n} projetos',
      scope: '{count} em {label}',
      listLabel: 'Projetos',
      contactTitle: 'Não achou um exemplo parecido com o seu caso?',
      contactText: 'Conte o que você precisa. A maioria dos projetos começa com uma conversa curta sobre a operação.',
      contactAction: 'Falar com Rafael',
    }
  : {
      workIndex: 'Work',
      servicesIndex: 'Services',
      note: 'Every project here is my own work, built to show how I work.',
      noteMore: 'Client work is not shown; real experience is in the CV.',
      filterLabel: 'Filter by type',
      one: '{n} project',
      other: '{n} projects',
      scope: '{count} in {label}',
      listLabel: 'Projects',
      contactTitle: 'No example close to your case?',
      contactText: 'Tell me what you need. Most projects start with a short conversation about the operation.',
      contactAction: 'Talk to Rafael',
    };
---

{type === 'work' ? (
  <>
    <header class="page-head shell">
      <p class="section-index">{ui.workIndex}</p>
      <h1>{t.workTitle}</h1>
      <p class="lede">{t.workIntro}</p>
      <p class="note"><Icon name="info" /><span><strong>{ui.note}</strong> {ui.noteMore}</span></p>
    </header>

    <section class="work shell" aria-label={ui.listLabel} data-work data-count-one={ui.one} data-count-other={ui.other} data-scope={ui.scope}>
      <div class="work__toolbar">
        <div class="filters" role="group" aria-label={ui.filterLabel} hidden data-filters>
          {kinds.map((kind) => (
            <button class="filters__chip" type="button" aria-pressed={kind.value === 'all' ? 'true' : 'false'} data-filter={kind.value} data-label={kind.label}>
              <span class="filters__check"><Icon name="check" /></span>{kind.label}<span class="filters__count" aria-hidden="true">{countFor(kind.value)}</span>
            </button>
          ))}
        </div>
        <p class="work__status" role="status" data-work-status>{ui.other.replace('{n}', String(projects.length))}</p>
      </div>
      <ul class="work-grid">
        {projects.map((project, index) => (
          <li data-kind={project.kind}>
            <ProjectCard project={project} locale={locale} number={index + 1} headingLevel="h2" loading={index < 2 ? 'eager' : 'lazy'} />
          </li>
        ))}
      </ul>
    </section>
  </>
) : (
  <>
    <header class="page-head shell">
      <p class="section-index">{ui.servicesIndex}</p>
      <h1>{t.servicesPageTitle}</h1>
      <p class="lede">{t.servicesPageIntro}</p>
    </header>
    <section class="shell" aria-label={t.nav.services}>
      <ServiceList locale={locale} headingLevel="h2" detailed preview />
    </section>
  </>
)}

<aside class="cta-band shell" aria-labelledby="listing-cta-title">
  <div>
    <h2 id="listing-cta-title">{ui.contactTitle}</h2>
    <p>{ui.contactText}</p>
  </div>
  <a class="button button--primary" href={withLocale(locale, 'contact')}>{ui.contactAction}<Icon name="arrow-right" /></a>
</aside>

<script>
  import { ALL, formatCount, matchesFilter } from '@/components/ui/work-filter';

  document.querySelectorAll<HTMLElement>('[data-work]').forEach((root) => {
    const group = root.querySelector<HTMLElement>('[data-filters]');
    const status = root.querySelector<HTMLElement>('[data-work-status]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-kind]')];
    if (!group || !status) return;
    const { countOne = '', countOther = '', scope = '' } = root.dataset;

    const apply = (button: HTMLButtonElement) => {
      const filter = button.dataset.filter ?? ALL;
      buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      let visible = 0;
      items.forEach((item) => {
        const show = matchesFilter(item.dataset.kind, filter);
        item.hidden = !show;
        if (show) visible += 1;
      });
      const count = formatCount(visible, countOne, countOther);
      status.textContent = filter === ALL ? count : scope.replace('{count}', count).replace('{label}', button.dataset.label ?? '');
    };

    group.hidden = false;
    buttons.forEach((button) => button.addEventListener('click', () => apply(button)));
  });
</script>
